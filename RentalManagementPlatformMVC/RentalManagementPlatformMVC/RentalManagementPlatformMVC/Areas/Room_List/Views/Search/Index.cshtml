@using RentalManagementPlatformMVC.Areas.Room_List.Models

@{
    ViewData["Title"] = "房源搜尋";
    var currentQuery = ViewData["CurrentQuery"] as string;
    var currentStatus = Context.Request.Query["status"].ToString();
}

<h1>房源搜尋</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-area="Room_List" asp-controller="Search" asp-action="Index" method="get" id="searchForm">
            <div class="input-group mb-3">
                <input type="search" name="query" class="form-control" placeholder="請輸入房型地址" value="@currentQuery" autocomplete="off" />
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary" style="display: none;">搜尋</button>
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select" name="status">
                    <option value="">全部狀態</option>
                    <option value="待審核" selected="@(currentStatus=="待審核")">待審核</option>
                    <option value="上架中" selected="@(currentStatus=="上架中")">上架中</option>
                    <option value="已下架" selected="@(currentStatus=="已下架")">已下架</option>
                    <option value="已通過" selected="@(currentStatus=="已通過")">已通過</option>
                    <option value="已刪除" selected="@(currentStatus=="已刪除")">已刪除</option>
                    <option value="已拒絕" selected="@(currentStatus=="已拒絕")">已拒絕</option>
                </select>
            </div>
            
        </form>
    </div>
</div>






<hr />

<div id="searchResultsContainer">
    <!-- AJAX results will be loaded here -->
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.querySelector('input[name="query"]');
            const statusSelect = document.querySelector('select[name="status"]');
            const resultsContainer = document.getElementById('searchResultsContainer');
            const searchForm = document.getElementById('searchForm');

            // 防止使用者快速輸入造成每個字都發請求，會 延遲 300ms 才真的送出查詢。
            function debounce(func, delay) {
                let timeout;
                return function(...args) {
                    const context = this;
                    clearTimeout(timeout);
                    timeout = setTimeout(() => func.apply(context, args), delay);
                };
            }

            function performSearch(query, status) {
                // We can search even with an empty query if a status is selected
                if ((query === null || query.trim() === '') && (status === null || status.trim() === '')) {
                    resultsContainer.innerHTML = ''; // Clear results only if both are empty
                    return;
                }
                
                resultsContainer.innerHTML = '<p><em>Searching...</em></p>';
                
                // Build URL safely
                const url = new URL('@Url.Action("Ajax", "Search", new { Area = "Room_List" })', window.location.origin);
                url.searchParams.set('query', query || '');
                url.searchParams.set('status', status || '');

                fetch(url)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Network response was not ok: ' + response.statusText);
                        }
                        return response.text(); // We expect HTML, so use .text()
                    })
                    .then(html => {
                        resultsContainer.innerHTML = html;
                    })
                    .catch(error => {
                        console.error('Fetch error:', error);
                        resultsContainer.innerHTML = '<p class="text-danger">An error occurred while fetching results.</p>';
                    });
            }

            const debouncedSearch = debounce(function() {
                const query = searchInput.value;
                const status = statusSelect.value;
                performSearch(query, status);
            }, 300);

            // Initial search on page load with current values
            debouncedSearch();

            // Add listeners to both controls
            searchInput.addEventListener('input', debouncedSearch);
            statusSelect.addEventListener('change', debouncedSearch);

            searchForm.addEventListener('submit', function (e) {
                e.preventDefault(); 
            });
            //攔截submit 只走ajax
        });
    </script>
}
