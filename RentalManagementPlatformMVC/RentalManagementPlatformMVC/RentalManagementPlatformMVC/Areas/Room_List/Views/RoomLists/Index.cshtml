@model IEnumerable<RentalManagementPlatformMVC.Areas.Room_List.Models.RoomSummaryViewModel>

@{
	ViewData["Title"] = "房源列表";
}

<h1>房源列表</h1>


<table class="table">
	<thead>
		<tr>

			<th>
				@Html.DisplayNameFor(model => model.RoomId)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Title)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.HostName)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Status)
			</th>
			<th>
				封面照
			</th>
			<th>
				選項
			</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.RoomId)
				</td>

				<td>
					@Html.DisplayFor(modelItem => item.Title)
				</td>


				<td>
					@Html.DisplayFor(modelItem => item.HostName)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Status)
				</td>
				<td>
					@if (!string.IsNullOrEmpty(item.MainImageUrl))
					{
						<img src="@item.MainImageUrl"
							 style="width: 150px; height: 100px; object-fit: cover;"
							 alt="Room Image" />

					}
				</td>
				<td>
					@if (!item.IsDeleted)
					{
						<a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.RoomId">編輯</a>
						<a class="btn btn-sm btn-outline-success" asp-action="Upload" asp-route-id="@item.RoomId">上傳圖片</a>
					}
					<a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@item.RoomId">詳細</a>
					@if (!item.IsDeleted)
					{
						<a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.RoomId">刪除</a>
					}
				</td>
			</tr>
		}
	</tbody>
</table>
