@model RentalManagementPlatformMVC.Areas.Room_List.Models.RoomInputViewModel

@{
    ViewData["Title"] = "Upload Image";
}

<h1>Upload Image for @Model.Title</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="UploadImage" asp-route-id="@Model.RoomId" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="RoomId" />
            
            <div class="form-group mb-3">
                <label for="imageFile" class="control-label">Select Image</label>
                <input name="imageFile" type="file" class="form-control" />
            </div>
            
            <div class="form-group">
                <input type="submit" value="Upload" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
