@model RentalManagementPlatformMVC.Areas.Booking.ViewModels.BookingIndexViewModel

@{
    ViewData["Title"] = "訂單管理";
}

<div class="content-header mt-3">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">訂單管理</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">訂單列表</h3>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped mb-0 text-center">
                        <thead class="thead-light">
                            <tr>
                                <th>訂單編號</th>
                                <th>訂房旅客</th>
                                <th>入住時間</th>
                                <th>退房時間</th>
                                <th>總金額</th>
                                <th>狀態</th>
                                <th>建立時間</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Bookings != null && Model.Bookings.Any())
                            {
                                foreach (var item in Model.Bookings)
                                {
                                    <tr>
                                        <td>@item.OrderNumber</td>
                                        <td>@item.GuestName</td>
                                        <td>@item.CheckIn?.ToString("yyyy-MM-dd")</td>
                                        <td>@item.CheckOut?.ToString("yyyy-MM-dd")</td>
                                        <td>@item.TotalPrice?.ToString("N0")</td>
                                        <td>
                                            <span class="badge bg-@(item.Status == "已完成" ? "success" : item.Status == "待確認" ? "warning" : "secondary")">
                                                @item.Status
                                            </span>
                                        </td>
                                        <td>@item.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">目前沒有資料</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* 僅在需要時顯示分頁器 *@
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer clearfix">
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm m-0 justify-content-center">
                            <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-area="Booking"
                                   asp-controller="BookingHome"
                                   asp-action="Index"
                                   asp-route-pageIndex="@(Model.PageIndex - 1)"
                                   asp-route-pageSize="@(Model.PageSize)">上一頁</a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link"
                                       asp-area="Booking"
                                       asp-controller="BookingHome"
                                       asp-action="Index"
                                       asp-route-pageIndex="@i"
                                       asp-route-pageSize="@(Model.PageSize)">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-area="Booking"
                                   asp-controller="BookingHome"
                                   asp-action="Index"
                                   asp-route-pageIndex="@(Model.PageIndex + 1)"
                                   asp-route-pageSize="@(Model.PageSize)">下一頁</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</section>
