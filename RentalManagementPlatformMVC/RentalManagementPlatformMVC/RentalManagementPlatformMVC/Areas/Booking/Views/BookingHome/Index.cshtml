@model RentalManagementPlatformMVC.Areas.Booking.ViewModels.BookingIndexViewModel
@using Microsoft.AspNetCore.Routing
@using RentalManagementPlatformMVC.DTOs

@{
    ViewData["Title"] = "訂單管理";
    // 計算本頁顯示的起始與結束資料編號
    var startRecord = (Model.PageIndex - 1) * Model.PageSize + 1;
    var endRecord = Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount);

    // 計算當前頁數與總頁數
    var currentPage = Model.PageIndex;
    var totalPages = Model.TotalPages;

    // 取得目前條件（Controller 有填 ViewBag.Criteria）
    var c = ViewBag.Criteria as BookingSearchCriteria ?? new BookingSearchCriteria();

    // ✅ 將目前條件轉為 Dictionary<string,string?>，供分頁/排序連結沿用
    var routeBase = new Dictionary<string, string?>
    {
        ["OrderNumber"] = c.OrderNumber,
        ["Status"] = c.Status,
        ["GuestName"] = c.GuestName,
        ["Room"] = c.Room,
        ["CheckInStartDate"] = c.CheckInStartDate?.ToString("yyyy-MM-dd"),
        ["CheckInEndDate"] = c.CheckInEndDate?.ToString("yyyy-MM-dd"),
        ["CheckOutStartDate"] = c.CheckOutStartDate?.ToString("yyyy-MM-dd"),
        ["CheckOutEndDate"] = c.CheckOutEndDate?.ToString("yyyy-MM-dd"),
        ["MinPrice"] = c.MinPrice?.ToString(),
        ["MaxPrice"] = c.MaxPrice?.ToString(),
        ["SortBy"] = c.SortBy,
        ["IsDescending"] = c.IsDescending.ToString().ToLower() // "true" 或 "false"
    };
}

<div class="content-header mt-3">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">訂單管理</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <!-- 🔎 搜尋條件卡片 -->
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">搜尋條件</h3>
            </div>
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-12 col-md-3">
                        <label class="form-label">訂單編號</label>
                        <input name="OrderNumber" class="form-control" value="@(c.OrderNumber ?? "")" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">狀態</label>
                        <select name="Status" class="form-select">
                            <option value="">— 全部 —</option>

                            @if (c.Status == "confirmed")
                            {
                                <option value="confirmed" selected>已確認</option>
                            }
                            else
                            {
                                <option value="confirmed">已確認</option>
                            }

                            @if (c.Status == "pending")
                            {
                                <option value="pending" selected>待確認</option>
                            }
                            else
                            {
                                <option value="pending">待確認</option>
                            }

                            @if (c.Status == "cancelled")
                            {
                                <option value="cancelled" selected>已取消</option>
                            }
                            else
                            {
                                <option value="cancelled">已取消</option>
                            }

                            @if (c.Status == "completed")
                            {
                                <option value="completed" selected>已完成</option>
                            }
                            else
                            {
                                <option value="completed">已完成</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">訂房姓名</label>
                        <input name="GuestName" class="form-control" value="@(c.GuestName ?? "")" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">房間</label>
                        <input name="Room" class="form-control" placeholder="輸入房名關鍵字" value="@(c.Room ?? "")" />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">入住起</label>
                        <input type="date" name="CheckInStartDate" class="form-control"
                               value="@(c.CheckInStartDate?.ToString("yyyy-MM-dd") ?? "")" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">入住迄</label>
                        <input type="date" name="CheckInEndDate" class="form-control"
                               value="@(c.CheckInEndDate?.ToString("yyyy-MM-dd") ?? "")" />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">退房起</label>
                        <input type="date" name="CheckOutStartDate" class="form-control"
                               value="@(c.CheckOutStartDate?.ToString("yyyy-MM-dd") ?? "")" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">退房迄</label>
                        <input type="date" name="CheckOutEndDate" class="form-control"
                               value="@(c.CheckOutEndDate?.ToString("yyyy-MM-dd") ?? "")" />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">最低金額</label>
                        <input type="number" name="MinPrice" class="form-control" step="1"
                               value="@(c.MinPrice?.ToString() ?? "")" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">最高金額</label>
                        <input type="number" name="MaxPrice" class="form-control" step="1"
                               value="@(c.MaxPrice?.ToString() ?? "")" />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">排序欄位</label>
                        <select name="SortBy" class="form-select">
                            @if (c.SortBy == "CreatedAt")
                            {
                                <option value="CreatedAt" selected>建立時間</option>
                            }
                            else
                            {
                                <option value="CreatedAt">建立時間</option>
                            }

                            @if (c.SortBy == "CheckIn")
                            {
                                <option value="CheckIn" selected>入住日</option>
                            }
                            else
                            {
                                <option value="CheckIn">入住日</option>
                            }

                            @if (c.SortBy == "CheckOut")
                            {
                                <option value="CheckOut" selected>退房日</option>
                            }
                            else
                            {
                                <option value="CheckOut">退房日</option>
                            }

                            @if (c.SortBy == "TotalPrice")
                            {
                                <option value="TotalPrice" selected>總金額</option>
                            }
                            else
                            {
                                <option value="TotalPrice">總金額</option>
                            }

                            @if (c.SortBy == "OrderNumber")
                            {
                                <option value="OrderNumber" selected>訂單編號</option>
                            }
                            else
                            {
                                <option value="OrderNumber">訂單編號</option>
                            }

                            @if (c.SortBy == "Status")
                            {
                                <option value="Status" selected>狀態</option>
                            }
                            else
                            {
                                <option value="Status">狀態</option>
                            }
                        </select>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">排序方式</label>
                        <select name="IsDescending" class="form-select">
                            @if (c.IsDescending)
                            {
                                <option value="true" selected>降冪（新→舊 / 高→低）</option>
                            }
                            else
                            {
                                <option value="true">降冪（新→舊 / 高→低）</option>
                            }

                            @if (!c.IsDescending)
                            {
                                <option value="false" selected>升冪（舊→新 / 低→高）</option>
                            }
                            else
                            {
                                <option value="false">升冪（舊→新 / 低→高）</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">搜尋</button>
                        <a class="btn btn-outline-secondary"
                           asp-area="Booking" asp-controller="BookingHome" asp-action="Index">重設</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- 📋 原本的訂單列表卡片 -->
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">訂單列表</h3>
            </div>

            <div class="card-body p-0">
                <div class="d-flex justify-content-between align-items-center px-3 py-2">
                    <div>
                        <span class="text-muted">共 @Model.TotalCount 筆資料</span>
                    </div>
                    <div>
                        <span class="text-muted">
                            顯示第 @startRecord - @endRecord 筆
                        </span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped mb-0 text-center align-middle">
                        <thead class="thead-light">
                            <tr>
                                <th>訂單編號</th>
                                <th>訂房姓名</th>
                                <th>入住日期</th>
                                <th>退房日期</th>
                                <th>總價格</th>
                                <th>狀態</th>
                                <th>建立日期</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Bookings != null && Model.Bookings.Any())
                            {
                                foreach (var item in Model.Bookings)
                                {
                                    <tr>
                                        <td>@item.OrderNumber</td>
                                        <td>@item.GuestName</td>
                                        <td>@item.CheckIn?.ToString("yyyy-MM-dd")</td>
                                        <td>@item.CheckOut?.ToString("yyyy-MM-dd")</td>
                                        <td>@item.TotalPrice?.ToString("N0")</td>
                                        <td>
                                            <span class="badge bg-success py-2 px-3
                                                @(item.Status?.ToLower() == "confirmed" ? "bg-success" :
                                                  item.Status?.ToLower() == "pending"   ? "bg-warning text-dark" :
                                                  item.Status?.ToLower() == "cancelled"  ? "bg-danger" :
                                                  "bg-secondary")">
                                                @item.DisplayStatus
                                            </span>
                                        </td>
                                        <td>@item.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <button class="btn btn-primary btn-detail" data-id="@item.BookingId">詳細</button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">目前沒有資料</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between align-items-center px-3 py-2">
                    <div>
                        <span class="text-muted">
                            第 @currentPage 頁，共 @totalPages 頁
                        </span>
                    </div>
                </div>
            </div>

            @* 分頁器（保留查詢參數） *@
            @if (Model.TotalPages > 1)
            {
                // 以現有的 routeBase (Dictionary<string,string?>) 為基礎，建立上一頁/下一頁參數
                var prev = new Dictionary<string, string?>(routeBase)
                {
                    ["pageIndex"] = (Model.PageIndex - 1).ToString(),
                    ["pageSize"] = Model.PageSize.ToString()
                };
                var next = new Dictionary<string, string?>(routeBase)
                {
                    ["pageIndex"] = (Model.PageIndex + 1).ToString(),
                    ["pageSize"] = Model.PageSize.ToString()
                };

                <div class="card-footer clearfix">
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm m-0 justify-content-center">
                            <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-area="Booking" asp-controller="BookingHome" asp-action="Index"
                                   asp-all-route-data="prev">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                var rv = new Dictionary<string, string?>(routeBase)
                                {
                                    ["pageIndex"] = i.ToString(),
                                    ["pageSize"] = Model.PageSize.ToString()
                                };

                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link"
                                       asp-area="Booking" asp-controller="BookingHome" asp-action="Index"
                                       asp-all-route-data="rv">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-area="Booking" asp-controller="BookingHome" asp-action="Index"
                                   asp-all-route-data="next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</section>


<!-- Modal -->
@section Modals {
    <div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="modal-detail-content">
                <!-- AJAX 載入內容 -->
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('click', async (e) => {
          const btn = e.target.closest('.btn-detail');
          if (!btn) return;
          e.preventDefault();

          const id = btn.dataset.id;
          const content = document.getElementById('modal-detail-content');

          // 顯示載入中 & 開窗
          btn.disabled = true;
          content.innerHTML = '<div class="modal-body text-center py-5"><div class="spinner-border" role="status"></div><div class="mt-2">載入中…</div></div>';
          const modalEl = document.getElementById('detailModal');
          const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
          modal.show();

          try {
            const url = '@Url.Action("Detail", "BookingHome", new { area = "Booking" })' + '?id=' + encodeURIComponent(id);
            const resp = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!resp.ok) {
              const msg = resp.status === 404 ? '找不到這筆訂單'
                      : resp.status === 403 ? '沒有權限檢視'
                      : `載入失敗（${resp.status}）`;
              throw new Error(msg);
            }
            const html = await resp.text();
            content.innerHTML = html; // 部分檢視含 modal-header + modal-body
          } catch (err) {
            content.innerHTML = `<div class="modal-body text-danger p-3">${err.message}</div>`;
          } finally {
            btn.disabled = false;
          }
        });
    </script>
}
