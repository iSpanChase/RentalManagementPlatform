@model RentalManagementPlatformMVC.Areas.Booking.ViewModels.BookingIndexViewModel
@using Microsoft.AspNetCore.Routing
@using RentalManagementPlatformMVC.DTOs

@{
    ViewData["Title"] = "訂單管理";

    // 計算本頁顯示的起始與結束資料編號
    var startRecord = (Model.PageIndex - 1) * Model.PageSize + 1;
    var endRecord = Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount);

    // 序號計算
    var index = startRecord;

    // 計算當前頁數與總頁數
    var currentPage = Model.PageIndex;
    var totalPages = Model.TotalPages;
    int range = 2; // 頁碼範圍

    // 將目前條件轉為 Dictionary<string,string?>，供分頁/排序連結沿用
    var routeBase = new Dictionary<string, string?>
    {
        ["OrderNumber"] = Model.Criteria.OrderNumber,
        ["Status"] = Model.Criteria.Status,
        ["GuestName"] = Model.Criteria.GuestName,
        ["Room"] = Model.Criteria.Room,
        ["CheckInStartDate"] = Model.Criteria.CheckInStartDate?.ToString("yyyy-MM-dd"),
        ["CheckInEndDate"] = Model.Criteria.CheckInEndDate?.ToString("yyyy-MM-dd"),
        ["CheckOutStartDate"] = Model.Criteria.CheckOutStartDate?.ToString("yyyy-MM-dd"),
        ["CheckOutEndDate"] = Model.Criteria.CheckOutEndDate?.ToString("yyyy-MM-dd"),
        ["MinPrice"] = Model.Criteria.MinPrice?.ToString(),
        ["MaxPrice"] = Model.Criteria.MaxPrice?.ToString(),
        ["SortBy"] = Model.Criteria.SortBy,
        ["IsDescending"] = Model.Criteria.IsDescending.ToString().ToLower()
    };


    <style>
        .page-title {
            font-family: 'Segoe UI', 'Microsoft JhengHei', 'Noto Sans TC', Arial, sans-serif;
            font-weight: 600;
            letter-spacing: 0.5px;
            color: #34495e;
        }

        .card-title {
            font-weight: bold;
        }
    </style>
}

<div class="content-header mt-3">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="page-title m-0">訂單管理</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <!--搜尋條件卡片Start-->
        <div class="card card-primary card-outline mb-3">
            <div class="card-header">
                <h3 class="card-title">搜尋條件</h3>
            </div>
            <div class="card-body">
                <form method="get" class="row g-3">
                    <input type="hidden" name="pageIndex" value="1" />
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />

                    <div class="col-12 col-md-3">
                        <label class="form-label">訂單編號</label>
                        <input name="OrderNumber" class="form-control" value="@(Model.Criteria.OrderNumber ?? "")" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">狀態</label>
                        <select name="Status" class="form-select">
                            <option value="">— 全部 —</option>

                            <option value="confirmed" selected="@(Model.Criteria.Status == "confirmed" ? "selected" : null)">已確認</option>
                            <option value="pending" selected="@(Model.Criteria.Status == "pending" ? "selected" : null)">待確認</option>
                            <option value="cancelled" selected="@(Model.Criteria.Status == "cancelled" ? "selected" : null)">已取消</option>
                            <option value="completed" selected="@(Model.Criteria.Status == "completed" ? "selected" : null)">已完成</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">訂房姓名</label>
                        <input name="GuestName" class="form-control" value="@(Model.Criteria.GuestName ?? "")" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">房間</label>
                        <input name="Room" class="form-control" placeholder="輸入房名關鍵字" value="@(Model.Criteria.Room ?? "")" />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">入住起</label>
                        <input type="date" name="CheckInStartDate" class="form-control"
                               value="@(Model.Criteria.CheckInStartDate?.ToString("yyyy-MM-dd") ?? "")" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">入住迄</label>
                        <input type="date" name="CheckInEndDate" class="form-control"
                               value="@(Model.Criteria.CheckInEndDate?.ToString("yyyy-MM-dd") ?? "")" />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">退房起</label>
                        <input type="date" name="CheckOutStartDate" class="form-control"
                               value="@(Model.Criteria.CheckOutStartDate?.ToString("yyyy-MM-dd") ?? "")" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">退房迄</label>
                        <input type="date" name="CheckOutEndDate" class="form-control"
                               value="@(Model.Criteria.CheckOutEndDate?.ToString("yyyy-MM-dd") ?? "")" />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">最低金額</label>
                        <input type="number" name="MinPrice" class="form-control" step="1"
                               value="@(Model.Criteria.MinPrice?.ToString() ?? "")" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">最高金額</label>
                        <input type="number" name="MaxPrice" class="form-control" step="1"
                               value="@(Model.Criteria.MaxPrice?.ToString() ?? "")" />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">排序欄位</label>
                        <select name="SortBy" class="form-select">
                            <option value="CreatedAt" selected="@(Model.Criteria.SortBy == "CreatedAt" ? "selected" : null)">建立時間</option>
                            <option value="CheckIn" selected="@(Model.Criteria.SortBy == "CheckIn" ? "selected" : null)">入住日</option>
                            <option value="CheckOut" selected="@(Model.Criteria.SortBy == "CheckOut" ? "selected" : null)">退房日</option>
                            <option value="TotalPrice" selected="@(Model.Criteria.SortBy == "TotalPrice" ? "selected" : null)">總金額</option>
                            <option value="OrderNumber" selected="@(Model.Criteria.SortBy == "OrderNumber" ? "selected" : null)">訂單編號</option>
                            <option value="Status" selected="@(Model.Criteria.SortBy == "Status" ? "selected" : null)">狀態</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">排序方式</label>
                        <select name="IsDescending" class="form-select">
                            <option value="true" selected="@(Model.Criteria.IsDescending ? "selected" : null)">降冪（新→舊 / 高→低）</option>
                            <option value="false" selected="@(!Model.Criteria.IsDescending ? "selected" : null)">升冪（舊→新 / 低→高）</option>
                        </select>
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-magnifying-glass"></i>搜尋</button>
                        <a class="btn btn-outline-secondary"
                           asp-area="Booking"
                           asp-controller="BookingHome"
                           asp-action="Index">
                            <i class="fa-solid fa-rotate-right"></i>重設
                       </a>
                    </div>
                </form>
            </div>
        </div>
        <!--搜尋條件卡片End-->

        <!--訂單列表卡片Start-->
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">訂單列表</h3>
            </div>
            <div class="card-body p-0">
                <div class="d-flex justify-content-between align-items-center px-3 py-2">
                    <div>
                        <span class="text-muted">共 @Model.TotalCount 筆資料</span>
                    </div>
                    <div>
                        <span class="text-muted">
                            顯示第 @startRecord - @endRecord 筆
                        </span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped mb-0 text-center align-middle">
                        <thead class="thead-light">
                            <tr>
                                <th>序號</th>
                                <th>訂單編號</th>
                                <th>訂房姓名</th>
                                <th>入住日期</th>
                                <th>退房日期</th>
                                <th>總金額</th>
                                <th>狀態</th>
                                <th>建立時間</th>
                                <th>詳細</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Bookings != null && Model.Bookings.Any())
                            {
                                foreach (var item in Model.Bookings)
                                {
                                    <tr>
                                        <td>@index</td>
                                        <td>@item.OrderNumber</td>
                                        <td>@item.GuestName</td>
                                        <td>@item.CheckIn?.ToString("yyyy-MM-dd")</td>
                                        <td>@item.CheckOut?.ToString("yyyy-MM-dd")</td>
                                        <td>NT$ @item.TotalPrice?.ToString("N0")</td>
                                        <td>
                                            <span class="badge py-2 px-3
                                                @(item.Status?.ToLower() == "confirmed" ? "bg-success" :
                                                  item.Status?.ToLower() == "pending"   ? "bg-warning text-dark" :
                                                  item.Status?.ToLower() == "cancelled"  ? "bg-danger" :
                                                  item.Status?.ToLower() == "completed"  ? "bg-info" :
                                                  "bg-secondary")">
                                                @item.DisplayStatus
                                            </span>
                                        </td>
                                        <td>@item.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <button class="btn btn-primary btn-detail" data-id="@item.BookingId">查看</button>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">目前沒有資料</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between align-items-center px-3 py-2">
                    <div>
                        <span class="text-muted">
                            第 @currentPage 頁，共 @totalPages 頁
                        </span>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-success btn-sm"
                           asp-area="Booking" asp-controller="BookingHome" asp-action="ExportExcel"
                           asp-all-route-data="routeBase"
                           asp-route-pageIndex="@Model.PageIndex"
                           asp-route-pageSize="@Model.PageSize">
                            <i class="fa-solid fa-file-excel"></i>
                            匯出 Excel
                        </a>
                        <a class="btn btn-outline-primary btn-sm"
                           asp-area="Booking" asp-controller="BookingHome" asp-action="ExportCsv"
                           asp-all-route-data="routeBase"
                           asp-route-pageIndex="@Model.PageIndex"
                           asp-route-pageSize="@Model.PageSize">
                            <i class="fa-solid fa-file-csv"></i>
                            匯出 CSV
                        </a>
                        <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 px-3" 
                                title="重新整理資料"
                                style="border-radius: 6px;"
                                onclick="location.reload()">
                            <i class="fas fa-sync-alt"></i>
                            <span>重新整理</span>
                        </button>
                    </div>
                </div>
            </div>

            @* 僅在需要時顯示分頁器 *@
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer clearfix">
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm m-0 justify-content-center">

                            <!-- 上一頁 -->
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-area="Booking" asp-controller="BookingHome" asp-action="Index"
                                   asp-all-route-data="routeBase"
                                   asp-route-pageIndex="@(currentPage - 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    &laquo;
                                </a>
                            </li>

                            <!-- 第一頁 -->
                            @if (currentPage > range + 2)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-area="Booking" asp-controller="BookingHome" asp-action="Index"
                                       asp-all-route-data="routeBase"
                                       asp-route-pageIndex="1"
                                       asp-route-pageSize="@Model.PageSize">
                                        1
                                    </a>
                                </li>
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }

                            <!-- 中間範圍 -->
                            @for (int i = Math.Max(1, currentPage - range); i <= Math.Min(totalPages, currentPage + range); i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-area="Booking" asp-controller="BookingHome" asp-action="Index"
                                       asp-all-route-data="routeBase"
                                       asp-route-pageIndex="@i"
                                       asp-route-pageSize="@Model.PageSize">
                                        @i
                                    </a>
                                </li>
                            }

                            <!-- 最後一頁 -->
                            @if (currentPage < totalPages - (range + 1))
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-area="Booking" asp-controller="BookingHome" asp-action="Index"
                                       asp-all-route-data="routeBase"
                                       asp-route-pageIndex="@totalPages"
                                       asp-route-pageSize="@Model.PageSize">
                                        @totalPages
                                    </a>
                                </li>
                            }

                            <!-- 下一頁 -->
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-area="Booking" asp-controller="BookingHome" asp-action="Index"
                                   asp-all-route-data="routeBase"
                                   asp-route-pageIndex="@(currentPage + 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    &raquo;
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
        <!--訂單列表卡片End-->

    </div>
</section>

@section Modals {
    <div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="modal-detail-content">
                <!-- AJAX 載入內容 -->
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('click', async (e) => {
          const btn = e.target.closest('.btn-detail');
          if (!btn) return;
          e.preventDefault();

          const id = btn.dataset.id;
          const content = document.getElementById('modal-detail-content');

          // 顯示載入中 & 開窗
          btn.disabled = true;
          content.innerHTML = '<div class="modal-body text-center py-5"><div class="spinner-border" role="status"></div><div class="mt-2">載入中…</div></div>';
          const modalEl = document.getElementById('detailModal');
          const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
          modal.show();

          try {
            const url = '@Url.Action("Detail", "BookingHome", new { area = "Booking" })' + '?bookingId=' + encodeURIComponent(id);
            const resp = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!resp.ok) {
              const msg = resp.status === 404 ? '找不到這筆訂單'
                      : resp.status === 403 ? '沒有權限檢視'
                      : `載入失敗（${resp.status}）`;
              throw new Error(msg);
            }
            const html = await resp.text();
            content.innerHTML = html; // 部分檢視含 modal-header + modal-body
          } catch (err) {
            content.innerHTML = `<div class="modal-body text-danger p-3">${err.message}</div>`;
          } finally {
            btn.disabled = false;
          }
        });
    </script>
}
