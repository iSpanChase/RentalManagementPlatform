<!-- 新增／編輯 Modal -->
<div class="modal fade" id="planModal" tabindex="-1" aria-labelledby="planModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header border-0">
                <div class="d-flex flex-column">
                    <div class="fs-5 fw-semibold" id="planModalLabel">新增方案</div>
                    <div class="text-secondary small">方案會先以「草稿」狀態建立，啟用後才會生效</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body pt-0">
                <form id="planForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="planId" />
                    <div class="row g-3">
                        <!-- 方案名稱 -->
                        <div class="col-12 col-md-6">
                            <label for="planName" class="form-label fw-semibold">方案名稱 *</label>
                            <input type="text"
                                   id="planName"
                                   class="form-control"
                                   placeholder="例如：專業會員"
                                   required />
                        </div>

                        <!-- 月費 -->
                        <div class="col-6 col-md-3">
                            <label for="monthlyFee" class="form-label fw-semibold">月費 (元) *</label>
                            <input type="number"
                                   id="monthlyFee"
                                   class="form-control"
                                   min="0"
                                   value="0"
                                   required />
                        </div>

                        <!-- 抽成比例 -->
                        <div class="col-6 col-md-3">
                            <label for="commissionRate" class="form-label fw-semibold">抽成比例 (%) *</label>
                            <input type="number"
                                   id="commissionRate"
                                   class="form-control"
                                   min="0"
                                   max="100"
                                   step="0.01"
                                   placeholder="15"
                                   required />
                        </div>

                        <!-- 會員權益 -->
                        <div class="col-12">
                            <div class="border rounded-3 p-3">
                                <div class="text-muted fw-semibold mb-2">
                                    <i class="bi bi-stars me-1"></i> 會員權益
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="perkPriority">
                                            <label class="form-check-label" for="perkPriority">
                                                優先曝光
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="perkAnalytics">
                                            <label class="form-check-label" for="perkAnalytics">
                                                數據分析
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer border-0">
                <button type="button" id="btnSavePlan" class="btn btn-primary">儲存</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
            </div>
        </div>
    </div>
</div>
