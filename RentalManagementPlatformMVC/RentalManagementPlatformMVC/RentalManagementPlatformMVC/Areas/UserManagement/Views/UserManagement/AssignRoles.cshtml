@model RentalManagementPlatformMVC.Areas.UserManagement.ViewModels.AssignUserRolesVm
@{
    ViewData["Title"] = "指派角色";
}
<div class="content-header mt-3">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h2 class="mb-0">指派角色給：@Model.Name (@Model.Username)</h2>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline mb-3">
            <div class="card-body">
                <form method="post" asp-area="UserManagement" asp-controller="UserManagement" asp-action="AssignRoles">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr>
                                            <th style="width:60px;">
                                                <input type="checkbox" id="chkAll"
                                                       onclick="document.querySelectorAll('.rolechk').forEach(x=>x.checked=this.checked);" />
                                            </th>
                                            <th>角色名稱</th>
                                            <th>代碼</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in Model.Roles)
                                        {
                                            <tr>
                                                <td>
                                                    <input class="form-check-input rolechk" type="checkbox"
                                                           name="SelectedRoleIds" value="@r.RoleId" @(r.Checked ? "checked" : "") />
                                                </td>
                                                <td>@r.RoleName</td>
                                                <td><code>@r.RoleCode</code></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                        <div class="text-end">
                            <button class="btn btn-primary" type="submit">儲存</button>
                            <a class="btn btn-secondary" asp-area="UserManagement" asp-controller="UserManagement" asp-action="Index">返回</a>
                        </div>
                </form>
            </div>
        </div>
    </div>
</section>
