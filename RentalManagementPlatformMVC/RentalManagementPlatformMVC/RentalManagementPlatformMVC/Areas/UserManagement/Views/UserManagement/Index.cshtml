@model RentalManagementPlatformMVC.Areas.UserManagement.ViewModels.UserIndexVm
@{
    ViewData["Title"] = "會員管理";

    // 計算本頁顯示的起始與結束資料編號
    var startRecord = (Model.CurrentPage - 1) * Model.PageSize + 1;
    var endRecord = Math.Min(Model.CurrentPage * Model.PageSize, Model.Total);

    // 序號計算
    var index = startRecord;

    var q = Model.Query;
    var currentPage = Model.CurrentPage;   // 避免 Razor 把 @page 當成指令
    var totalPages = Model.TotalPages;
    var pageSize = Model.PageSize;
    int range = 2; // 頁碼範圍
}
@{
    var alertMsg = TempData["AlertMessage"] as string;
    var alertType = (TempData["AlertType"] as string) ?? "info"; // success/info/warning/danger
    var alertTitle = (TempData["AlertTitle"] as string) ?? "訊息";
}

@if (!string.IsNullOrWhiteSpace(alertMsg))
{
    <div class="alert alert-@(
         alertType == "danger" ? "danger" :
         alertType == "warning" ? "warning" :
         alertType == "success" ? "success" : "info"
        ) alert - dismissible fade show" role="alert">
    <strong>@alertTitle：</strong> @alertMsg
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
}


@functions {
    string NextDir(string col, string? current, string? dir)
        => string.Equals(col, current, StringComparison.OrdinalIgnoreCase) && string.Equals(dir, "asc", StringComparison.OrdinalIgnoreCase)
           ? "desc" : "asc";
    string Arrow(string col, string? current, string? dir)
        => string.Equals(col, current, StringComparison.OrdinalIgnoreCase)
           ? (string.Equals(dir, "asc", StringComparison.OrdinalIgnoreCase) ? "▲" : "▼") : "";
}

<div class="content-header mt-3">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0" style="font-family: 'Segoe UI', 'Microsoft JhengHei', Arial, sans-serif; font-weight: 700; letter-spacing: 1px; color: #2c3e50;">
                    會員管理
                </h1>
            </div>
        </div>
    </div>
</div>


@* @if (TempData["ok"] != null)
{
    <div class="alert alert-success">@TempData["ok"]</div>
} *@

<section class="content">
    <div class="container-fluid">

        <!--搜尋條件卡片Start-->
        <div class="card card-primary card-outline mb-3">
            <div class="card-header">
                <h3 class="card-title" style="font-weight: bold;">搜尋條件</h3>
            </div>
            <div class="card-body">
                <form method="get" asp-area="UserManagement" asp-controller="UserManagement" asp-action="Index">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">關鍵字（帳號/Email/姓名）</label>
                            <input class="form-control" name="Keyword" value="@Model.Filter.Keyword" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">性別</label>
                            <select class="form-select" name="Gender">
                                <option value="">— 全部 —</option>
                                <option value="M" selected="@(Model.Filter.Gender == "M")">男</option>
                                <option value="F" selected="@(Model.Filter.Gender == "F")">女</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">是否驗證</label>
                            <select class="form-select" name="Isverified">
                                <option value="">— 全部 —</option>
                                <option value="true" selected="@(Model.Filter.Isverified == true)">已驗證</option>
                                <option value="false" selected="@(Model.Filter.Isverified == false)">未驗證</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">建立起</label>
                            <input type="date" class="form-control" name="CreatedFrom"
                                   value="@(Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">建立迄</label>
                            <input type="date" class="form-control" name="CreatedTo"
                                   value="@(Model.Filter.CreatedTo?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">分頁顯示數量</label>
                            <select class="form-select" name="PageSize">
                                @{
                                    int[] sizes = new[] { 10, 20, 50, 100 };
                                }
                                @foreach (var s in sizes)
                                {
                                    <option value="@s" selected="@(pageSize == s)">@s / page</option>
                                }
                            </select>
                        </div>
                    </div>

                    @* 保留目前的排序與頁大小（切換條件時從第1頁開始） *@
                    <input type="hidden" name="SortBy" value="@Model.SortBy" />
                    <input type="hidden" name="SortDir" value="@Model.SortDir" />
                    <input type="hidden" name="Page" value="1" />
                    <input type="hidden" name="PageSize" value="@pageSize" />

                    <div class="mt-3 text-end">
                        <button class="btn btn-primary" type="submit"><i class="fa-solid fa-magnifying-glass"></i>搜尋</button>
                        <a class="btn btn-outline-secondary"
                           asp-area="UserManagement" asp-controller="UserManagement" asp-action="Index"><i class="fa-solid fa-rotate-right"></i>重設</a>
                    </div>
                </form>
            </div>
        </div>
        <!--搜尋條件卡片End-->

        <!--會員列表卡片Start-->
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title" style="font-weight: bold;">會員列表</h3>
            </div>
            <div class="card-body p-0">
                <div class="d-flex justify-content-between align-items-center px-3 py-2">
                    <div>
                        <span class="text-muted">共 @Model.Total 筆資料</span>
                    </div>
                    <div>
                        <span class="text-muted">
                            顯示第 @startRecord - @endRecord 筆
                        </span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped mb-0 text-center align-middle">
                        <thead class="thead-light">
                            <tr>
                                <th>
                                    <a asp-area="UserManagement" asp-controller="UserManagement" asp-action="Index"
                                       asp-route-Keyword="@Model.Filter.Keyword"
                                       asp-route-Gender="@Model.Filter.Gender"
                                       asp-route-Isverified="@Model.Filter.Isverified"
                                       asp-route-CreatedFrom="@(Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd"))"
                                       asp-route-CreatedTo="@(Model.Filter.CreatedTo?.ToString("yyyy-MM-dd"))"
                                       asp-route-Page="1" asp-route-PageSize="@pageSize"
                                       asp-route-SortBy="id"
                                       asp-route-SortDir="@NextDir("id", Model.SortBy, Model.SortDir)">
                                        ID @Arrow("id", Model.SortBy, Model.SortDir)
                                    </a>
                                </th>
                                <th>
                                    <a asp-area="UserManagement" asp-controller="UserManagement" asp-action="Index"
                                       asp-route-Keyword="@Model.Filter.Keyword"
                                       asp-route-Gender="@Model.Filter.Gender"
                                       asp-route-Isverified="@Model.Filter.Isverified"
                                       asp-route-CreatedFrom="@(Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd"))"
                                       asp-route-CreatedTo="@(Model.Filter.CreatedTo?.ToString("yyyy-MM-dd"))"
                                       asp-route-Page="1" asp-route-PageSize="@pageSize"
                                       asp-route-SortBy="username"
                                       asp-route-SortDir="@NextDir("username", Model.SortBy, Model.SortDir)">
                                        帳號 @Arrow("username", Model.SortBy, Model.SortDir)
                                    </a>
                                </th>
                                <th>
                                    <a asp-area="UserManagement" asp-controller="UserManagement" asp-action="Index"
                                       asp-route-Keyword="@Model.Filter.Keyword"
                                       asp-route-Gender="@Model.Filter.Gender"
                                       asp-route-Isverified="@Model.Filter.Isverified"
                                       asp-route-CreatedFrom="@(Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd"))"
                                       asp-route-CreatedTo="@(Model.Filter.CreatedTo?.ToString("yyyy-MM-dd"))"
                                       asp-route-Page="1" asp-route-PageSize="@pageSize"
                                       asp-route-SortBy="name"
                                       asp-route-SortDir="@NextDir("name", Model.SortBy, Model.SortDir)">
                                        姓名 @Arrow("name", Model.SortBy, Model.SortDir)
                                    </a>
                                </th>
                                <th>
                                    <a asp-area="UserManagement" asp-controller="UserManagement" asp-action="Index"
                                       asp-route-Keyword="@Model.Filter.Keyword"
                                       asp-route-Gender="@Model.Filter.Gender"
                                       asp-route-Isverified="@Model.Filter.Isverified"
                                       asp-route-CreatedFrom="@(Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd"))"
                                       asp-route-CreatedTo="@(Model.Filter.CreatedTo?.ToString("yyyy-MM-dd"))"
                                       asp-route-Page="1" asp-route-PageSize="@pageSize"
                                       asp-route-SortBy="email"
                                       asp-route-SortDir="@NextDir("email", Model.SortBy, Model.SortDir)">
                                        電子信箱 @Arrow("email", Model.SortBy, Model.SortDir)
                                    </a>
                                </th>
                                <th>
                                    <a asp-area="UserManagement" asp-controller="UserManagement" asp-action="Index"
                                       asp-route-Keyword="@Model.Filter.Keyword"
                                       asp-route-Gender="@Model.Filter.Gender"
                                       asp-route-Isverified="@Model.Filter.Isverified"
                                       asp-route-CreatedFrom="@(Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd"))"
                                       asp-route-CreatedTo="@(Model.Filter.CreatedTo?.ToString("yyyy-MM-dd"))"
                                       asp-route-Page="1" asp-route-PageSize="@pageSize"
                                       asp-route-SortBy="createdAt"
                                       asp-route-SortDir="@NextDir("createdAt", Model.SortBy, Model.SortDir)">
                                        建立時間 @Arrow("createdAt", Model.SortBy, Model.SortDir)
                                    </a>
                                </th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var x in Model.Items)
                            {
                                <tr>
                                    <td>@x.UserId</td>
                                    <td>@x.Username</td>
                                    <td>@x.Name</td>
                                    <td>@x.Email</td>
                                    <td>@x.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-area="UserManagement" asp-controller="UserManagement" asp-action="AssignRoles"
                                           asp-route-id="@x.UserId" asp-permission="Users.AssignRoles">指派角色</a>

                                        <a class="btn btn-sm btn-primary"
                                           asp-area="UserManagement" asp-controller="UserManagement"
                                           asp-action="Edit" asp-route-id="@x.UserId" asp-permission="Users.Edit">編輯</a>

                                        <form asp-area="UserManagement" asp-controller="UserManagement" asp-action="Delete"
                                              method="post" class="d-inline" onsubmit="return confirm('確定刪除？');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@x.UserId" />
                                            <button type="submit" class="btn btn-sm btn-danger" asp-permission="Users.Delete">刪除</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between align-items-center px-3 py-2">
                    <div>
                        <span class="text-muted">
                            第 @currentPage 頁，共 @totalPages 頁
                        </span>
                    </div>
                    <a class="btn btn-primary" asp-area="UserManagement" asp-controller="UserManagement" asp-action="Create" asp-permission="Users.Create">新增使用者</a>
                </div>

                @* 僅在需要時顯示分頁器 *@
                @if (totalPages > 1)
                {
                    <div class="card-footer clearfix">
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm m-0 justify-content-center">

                                <!-- 上一頁 -->
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-area="UserManagement" asp-controller="UserManagement" asp-action="Index"
                                       asp-route-Page="@(currentPage - 1)"
                                       asp-route-pageSize="@pageSize">
                                        &laquo;
                                    </a>
                                </li>

                                <!-- 第一頁 -->
                                @if (currentPage > range + 2)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           asp-area="UserManagement" asp-controller="UserManagement" asp-action="Index"
                                           asp-route-Keyword="@Model.Filter.Keyword"
                                           asp-route-Gender="@Model.Filter.Gender"
                                           asp-route-Isverified="@Model.Filter.Isverified"
                                           asp-route-CreatedFrom="@(Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd"))"
                                           asp-route-CreatedTo="@(Model.Filter.CreatedTo?.ToString("yyyy-MM-dd"))"
                                           asp-route-Page="1"
                                           asp-route-pageSize="@pageSize"
                                           asp-route-SortBy="@Model.SortBy"
                                           asp-route-SortDir="@Model.SortDir">
                                            1
                                        </a>
                                    </li>
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }

                                <!-- 中間範圍 -->
                                @for (int i = Math.Max(1, currentPage - range); i <= Math.Min(totalPages, currentPage + range); i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link"
                                           asp-area="UserManagement" asp-controller="UserManagement" asp-action="Index"
                                           asp-route-Keyword="@Model.Filter.Keyword"
                                           asp-route-Gender="@Model.Filter.Gender"
                                           asp-route-Isverified="@Model.Filter.Isverified"
                                           asp-route-CreatedFrom="@(Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd"))"
                                           asp-route-CreatedTo="@(Model.Filter.CreatedTo?.ToString("yyyy-MM-dd"))"
                                           asp-route-Page="@i"
                                           asp-route-pageSize="@pageSize"
                                           asp-route-SortBy="@Model.SortBy"
                                           asp-route-SortDir="@Model.SortDir">
                                            @i
                                        </a>
                                    </li>
                                }

                                <!-- 最後一頁 -->
                                @if (currentPage < totalPages - (range + 1))
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                    <li class="page-item">
                                        <a class="page-link"
                                           asp-area="UserManagement" asp-controller="UserManagement" asp-action="Index"
                                           asp-route-Keyword="@Model.Filter.Keyword"
                                           asp-route-Gender="@Model.Filter.Gender"
                                           asp-route-Isverified="@Model.Filter.Isverified"
                                           asp-route-CreatedFrom="@(Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd"))"
                                           asp-route-CreatedTo="@(Model.Filter.CreatedTo?.ToString("yyyy-MM-dd"))"
                                           asp-route-Page="@totalPages"
                                           asp-route-pageSize="@pageSize"
                                           asp-route-SortBy="@Model.SortBy"
                                           asp-route-SortDir="@Model.SortDir">
                                            @totalPages
                                        </a>
                                    </li>
                                }

                                <!-- 下一頁 -->
                                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-area="UserManagement" asp-controller="UserManagement" asp-action="Index"
                                       asp-route-Keyword="@Model.Filter.Keyword"
                                       asp-route-Gender="@Model.Filter.Gender"
                                       asp-route-Isverified="@Model.Filter.Isverified"
                                       asp-route-CreatedFrom="@(Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd"))"
                                       asp-route-CreatedTo="@(Model.Filter.CreatedTo?.ToString("yyyy-MM-dd"))"
                                       asp-route-Page="@(currentPage + 1)"
                                       asp-route-pageSize="@pageSize"
                                       asp-route-SortBy="@Model.SortBy"
                                       asp-route-SortDir="@Model.SortDir">
                                        &raquo;
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
                <!--會員列表卡片End-->
            </div>
        </div>
    </div>
</section>
