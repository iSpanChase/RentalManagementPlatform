@model RentalManagementPlatformMVC.Areas.Payments.ViewModels.HostPayoutDetailViewModel

<!-- Header -->
<div class="modal-header border-0">
    <div class="d-flex flex-column">
        <div class="fs-5 fw-semibold">撥款詳細資料</div>
        <div class="text-secondary small">
            @Html.DisplayNameFor(m => m.PayoutId)：<span class="fw-semibold">@Html.DisplayFor(m => m.PayoutId)</span>
            <span class="mx-2">|</span>
            @Html.DisplayNameFor(m => m.HostName)：<span class="fw-semibold">@Html.DisplayFor(m => m.HostName)</span>
        </div>
    </div>
</div>

<!-- Body -->
<div class="modal-body pt-0">
    <div class="row g-3">
        <!-- 左半：撥款基本資訊 -->
        <div class="col-12 col-md-6">
            <div class="border rounded-3 p-3 h-100">
                <div class="text-muted fw-semibold mb-2">
                    <i class="bi bi-wallet2 me-1"></i> 撥款資訊
                </div>

                <div class="row small gy-2">
                    <div class="col-5 text-secondary">@Html.DisplayNameFor(m => m.AmountGross)</div>
                    <div class="col-7 fw-semibold text-end text-md-start">
                        @Html.DisplayFor(m => m.AmountGross)
                    </div>

                    <div class="col-5 text-secondary">@Html.DisplayNameFor(m => m.PlatformFee)</div>
                    <div class="col-7">
                        @Html.DisplayFor(m => m.PlatformFee)
                    </div>

                    <div class="col-5 text-secondary">@Html.DisplayNameFor(m => m.AmountNet)</div>
                    <div class="col-7 fw-medium">
                        @Html.DisplayFor(m => m.AmountNet)
                    </div>

                    <div class="col-5 text-secondary">@Html.DisplayNameFor(m => m.CycleStart)</div>
                    <div class="col-7">
                        @Html.DisplayFor(m => m.CycleStart) ~ @Html.DisplayFor(m => m.CycleEnd)
                    </div>

                    <div class="col-5 text-secondary">@Html.DisplayNameFor(m => m.PaidAt)</div>
                    <div class="col-7">
                        @if (Model.PaidAt.HasValue)
                        {
                            @Html.DisplayFor(m => m.PaidAt)
                        }
                        else
                        {
                            <text>處理中</text>
                        }
                    </div>

                    <div class="col-5 text-secondary">@Html.DisplayNameFor(m => m.Status)</div>
                    <div class="col-7">
                        <span class="badge py-2 px-3
                            @(Model.Status?.ToLower() == "paid" ? "bg-success" :
                              Model.Status?.ToLower() == "pending" ? "bg-warning text-dark" :
                              Model.Status?.ToLower() == "refunded" ? "bg-info text-dark" :
                              Model.Status?.ToLower() == "failed" ? "bg-danger" : "bg-secondary")">
                            @Html.DisplayFor(m => m.DisplayStatus)
                        </span>
                    </div>

                    <div class="col-5 text-secondary">@Html.DisplayNameFor(m => m.CreatedAt)</div>
                    <div class="col-7">@Html.DisplayFor(m => m.CreatedAt)</div>
                </div>
            </div>
        </div>

        <!-- 右半：撥款項目明細 -->
        <div class="col-12 col-md-6">
            <div class="border rounded-3 p-3 h-100">
                <div class="text-muted fw-semibold mb-2">
                    <i class="bi bi-list-ul me-1"></i>
                    @Html.DisplayNameFor(m => m.Items) (共 @Html.DisplayFor(m => m.ItemsCount) 筆)
                </div>

                @if (Model.Items == null || !Model.Items.Any())
                {
                    <div class="small text-muted">尚無撥款項目</div>
                }
                else
                {
                    <div class="table-responsive" style="overflow-x: auto; white-space: nowrap;">
                        <table class="table table-bordered table-striped text-center align-middle w-100">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:10%">@Html.DisplayNameFor(m => m.Items.First().PayoutItemId)</th>
                                    <th style="width:15%">@Html.DisplayNameFor(m => m.Items.First().OrderNumberSnapshot)</th>
                                    <th style="width:15%">@Html.DisplayNameFor(m => m.Items.First().AmountGross)</th>
                                    <th style="width:10%">@Html.DisplayNameFor(m => m.Items.First().CommissionPct)</th>
                                    <th style="width:15%">@Html.DisplayNameFor(m => m.Items.First().PlatformFee)</th>
                                    <th style="width:15%">@Html.DisplayNameFor(m => m.Items.First().Amount)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(_ => item.PayoutItemId)</td>
                                        <td>@Html.DisplayFor(_ => item.OrderNumberSnapshot)</td>
                                        <td>@Html.DisplayFor(_ => item.AmountGross)</td>
                                        <td>@Html.DisplayFor(_ => item.CommissionPct)</td>
                                        <td>@Html.DisplayFor(_ => item.PlatformFee)</td>
                                        <td>@Html.DisplayFor(_ => item.Amount)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Footer -->
<div class="modal-footer border-0">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">關閉</button>
</div>