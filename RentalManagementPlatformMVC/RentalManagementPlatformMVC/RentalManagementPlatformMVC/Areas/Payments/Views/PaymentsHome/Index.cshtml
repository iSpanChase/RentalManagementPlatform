@model RentalManagementPlatformMVC.Areas.Payments.ViewModels.PaymentIndexViewModel
@using Microsoft.AspNetCore.Routing
@using RentalManagementPlatformMVC.DTOs

@{
    ViewData["Title"] = "帳務管理";

    // 計算本頁顯示的起始與結束資料編號
    var startRecord = (Model.PageIndex - 1) * Model.PageSize + 1;
    var endRecord = Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount);

    // 計算當前頁數與總頁數
    var currentPage = Model.PageIndex;
    var totalPages = Model.TotalPages;
    int range = 2; // 當前頁左右顯示的範圍

    // 將目前條件轉為 Dictionary<string,string?>，供分頁/排序連結沿用（Payment 版）
    var routeBase = new Dictionary<string, string?>
    {
        ["OrderNumber"] = Model.Criteria?.OrderNumber,
        ["PaymentRef"] = Model.Criteria?.PaymentRef,
        ["TransactionRef"] = Model.Criteria?.TransactionRef,
        ["Status"] = Model.Criteria?.Status,
        ["GuestName"] = Model.Criteria?.GuestName,
        ["RoomTitle"] = Model.Criteria?.RoomTitle,
        ["PaidStartDate"] = Model.Criteria?.PaidStartDate?.ToString("yyyy-MM-dd"),
        ["PaidEndDate"] = Model.Criteria?.PaidEndDate?.ToString("yyyy-MM-dd"),
        ["MinAmount"] = Model.Criteria?.MinAmount?.ToString(),
        ["MaxAmount"] = Model.Criteria?.MaxAmount?.ToString(),
        ["SortBy"] = Model.Criteria?.SortBy,
        ["IsDescending"] = (Model.Criteria?.IsDescending ?? true).ToString().ToLower()
    };

    <style>
        .page-title {
            font-family: 'Segoe UI', 'Microsoft JhengHei', 'Noto Sans TC', Arial, sans-serif;
            font-weight: 600;
            letter-spacing: 0.5px;
            color: #34495e;
        }

        .card-title {
            font-weight: bold;
        }
    </style>
}

<div class="content-header mt-3">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="page-title m-0">帳務管理</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <!--搜尋條件卡片Start-->
        <div class="card card-primary card-outline mb-3">
            <div class="card-header">
                <h3 class="card-title" style="font-weight: bold;">搜尋條件</h3>
            </div>
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-12 col-md-3">
                        <label class="form-label">訂單編號</label>
                        <input name="OrderNumber" class="form-control" value="@(Model.Criteria?.OrderNumber ?? "")" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">平台付款編號（PaymentRef）</label>
                        <input name="PaymentRef" class="form-control" value="@(Model.Criteria?.PaymentRef ?? "")" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">交易參考號（TxnRef）</label>
                        <input name="TransactionRef" class="form-control" value="@(Model.Criteria?.TransactionRef ?? "")" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">狀態</label>
                        <select name="Status" class="form-select">
                            <option value="">— 全部 —</option>
                            <option value="paid" selected="@(Model.Criteria?.Status == "paid" ? "selected" : null)">已付款</option>
                            <option value="pending" selected="@(Model.Criteria?.Status == "pending" ? "selected" : null)">付款中</option>
                            <option value="refunded" selected="@(Model.Criteria?.Status == "refunded" ? "selected" : null)">已退款</option>
                            <option value="failed" selected="@(Model.Criteria?.Status == "failed" ? "selected" : null)">付款失敗</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">訂房姓名</label>
                        <input name="GuestName" class="form-control" value="@(Model.Criteria?.GuestName ?? "")" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">房間名稱</label>
                        <input name="RoomTitle" class="form-control" placeholder="輸入房名關鍵字" value="@(Model.Criteria?.RoomTitle ?? "")" />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">付款起</label>
                        <input type="date" name="PaidStartDate" class="form-control"
                               value="@(Model.Criteria?.PaidStartDate?.ToString("yyyy-MM-dd") ?? "")" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">付款迄</label>
                        <input type="date" name="PaidEndDate" class="form-control"
                               value="@(Model.Criteria?.PaidEndDate?.ToString("yyyy-MM-dd") ?? "")" />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">最低金額</label>
                        <input type="number" name="MinAmount" class="form-control" step="1"
                               value="@(Model.Criteria?.MinAmount?.ToString() ?? "")" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">最高金額</label>
                        <input type="number" name="MaxAmount" class="form-control" step="1"
                               value="@(Model.Criteria?.MaxAmount?.ToString() ?? "")" />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">排序欄位</label>
                        <select name="SortBy" class="form-select">
                            <option value="CreatedAt" selected="@(Model.Criteria?.SortBy == "CreatedAt" ? "selected" : null)">建立時間</option>
                            <option value="PaidAt" selected="@(Model.Criteria?.SortBy == "PaidAt" ? "selected" : null)">付款時間</option>
                            <option value="Amount" selected="@(Model.Criteria?.SortBy == "Amount" ? "selected" : null)">金額</option>
                            <option value="OrderNumber" selected="@(Model.Criteria?.SortBy == "OrderNumber" ? "selected" : null)">訂單編號</option>
                            <option value="PaymentRef" selected="@(Model.Criteria?.SortBy == "PaymentRef" ? "selected" : null)">平台付款編號</option>
                            <option value="Status" selected="@(Model.Criteria?.SortBy == "Status" ? "selected" : null)">狀態</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">排序方式</label>
                        <select name="IsDescending" class="form-select">
                            <option value="true" selected="@(Model.Criteria?.IsDescending != false ? "selected" : null)">降冪（新→舊 / 高→低）</option>
                            <option value="false" selected="@((Model.Criteria?.IsDescending == false) ? "selected" : null)">升冪（舊→新 / 低→高）</option>
                        </select>
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">搜尋</button>
                        <a class="btn btn-outline-secondary"
                           asp-area="Payments" asp-controller="PaymentsHome" asp-action="Index">重設</a>
                    </div>
                </form>
            </div>
        </div>
        <!--搜尋條件卡片End-->

        <!--訂單列表卡片Start-->
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">帳務列表</h3>
            </div>
            <div class="card-body p-0">
                <div class="d-flex justify-content-between align-items-center px-3 py-2">
                    <div>
                        <span class="text-muted">@Model.TotalCount 筆資料</span>
                    </div>
                    <div>
                        <span class="text-muted">顯示第 @startRecord - @endRecord 筆</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped mb-0 text-center align-middle">
                        <thead class="thead-light">
                            <tr>
                                <th>訂單編號</th>
                                <th>訂單金額</th>
                                <th>平台付款編號</th>
                                <th>付款方式</th>
                                <th>付款日期</th>
                                <th>狀態</th>
                                <th>建立日期</th>
                                <th>詳細</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Payments != null && Model.Payments.Any())
                            {
                                foreach(var item in Model.Payments)
                                {
                                    <tr>
                                        <td>@item.OrderNumberSnapshot</td>
                                        <td>NT$ @item.Amount?.ToString("N0")</td>
                                        <td>@item.PaymentRef</td>
                                        <td>@item.DisplayMethod</td>
                                        <td>@item.PaidAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <span class="badge py-2 px-3
                                                        @(item.Status?.ToLower() == "paid" ? "bg-success" :
                                                          item.Status?.ToLower() == "pending" ? "bg-warning text-dark" :
                                                          item.Status?.ToLower() == "refunded" ? "bg-info text-dark" :
                                                          item.Status?.ToLower() == "failed" ? "bg-danger" :
                                                          "bg-secondary")">
                                                        @item.DisplayStatus
                                            </span>
                                        </td>
                                        <td>@item.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <button class="btn btn-primary btn-detail" data-id="@item.PaymentId">詳細</button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">目前沒有資料</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between align-items-center px-3 py-2">
                    <div>
                        <span class="text-muted">
                            第 @currentPage 頁，共 @totalPages 頁
                        </span>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-success btn-sm"
                           asp-area="Payments" asp-controller="PaymentsHome" asp-action="ExportExcel"
                           asp-route-OrderNumber="@(Model.Criteria?.OrderNumber)"
                           asp-route-PaymentRef="@(Model.Criteria?.PaymentRef)"
                           asp-route-TransactionRef="@(Model.Criteria?.TransactionRef)"
                           asp-route-Status="@(Model.Criteria?.Status)"
                           asp-route-GuestName="@(Model.Criteria?.GuestName)"
                           asp-route-RoomTitle="@(Model.Criteria?.RoomTitle)"
                           asp-route-PaidStartDate="@(Model.Criteria?.PaidStartDate?.ToString("yyyy-MM-dd"))"
                           asp-route-PaidEndDate="@(Model.Criteria?.PaidEndDate?.ToString("yyyy-MM-dd"))"
                           asp-route-MinAmount="@(Model.Criteria?.MinAmount?.ToString())"
                           asp-route-MaxAmount="@(Model.Criteria?.MaxAmount?.ToString())"
                           asp-route-SortBy="@(Model.Criteria?.SortBy)"
                           asp-route-IsDescending="@((Model.Criteria?.IsDescending ?? true).ToString().ToLower())">
                            匯出 Excel
                        </a>

                        <a class="btn btn-outline-primary btn-sm"
                           asp-area="Payments" asp-controller="PaymentsHome" asp-action="ExportCsv"
                           asp-route-OrderNumber="@(Model.Criteria?.OrderNumber)"
                           asp-route-PaymentRef="@(Model.Criteria?.PaymentRef)"
                           asp-route-TransactionRef="@(Model.Criteria?.TransactionRef)"
                           asp-route-Status="@(Model.Criteria?.Status)"
                           asp-route-GuestName="@(Model.Criteria?.GuestName)"
                           asp-route-RoomTitle="@(Model.Criteria?.RoomTitle)"
                           asp-route-PaidStartDate="@(Model.Criteria?.PaidStartDate?.ToString("yyyy-MM-dd"))"
                           asp-route-PaidEndDate="@(Model.Criteria?.PaidEndDate?.ToString("yyyy-MM-dd"))"
                           asp-route-MinAmount="@(Model.Criteria?.MinAmount?.ToString())"
                           asp-route-MaxAmount="@(Model.Criteria?.MaxAmount?.ToString())"
                           asp-route-SortBy="@(Model.Criteria?.SortBy)"
                           asp-route-IsDescending="@((Model.Criteria?.IsDescending ?? true).ToString().ToLower())">
                            匯出 CSV
                        </a>
                    </div>
                </div>
            </div>

            @* 僅在需要時顯示分頁器 *@
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer clearfix">
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm m-0 justify-content-center">
                            <!-- 上一頁 -->
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-route-pageIndex="@(currentPage - 1)"
                                   asp-route-pageSize="@(Model.PageSize)">
                                    &laquo;
                                </a>
                            </li>

                            <!-- 第一頁 -->
                            @if (currentPage > range + 2)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-route-pageIndex="1" asp-route-pageSize="@Model.PageSize">1</a>
                                </li>
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }

                            <!-- 中間範圍 -->
                            @for (int i = Math.Max(1, currentPage - range); i <= Math.Min(totalPages, currentPage + range); i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-route-pageIndex="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                                </li>
                            }

                            <!-- 最後一頁 -->
                            @if (currentPage < totalPages - (range + 1))
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                                <li class="page-item">
                                    <a class="page-link" asp-route-pageIndex="@totalPages" asp-route-pageSize="@Model.PageSize">@totalPages</a>
                                </li>
                            }

                            <!-- 下一頁 -->
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-route-pageIndex="@(currentPage + 1)"
                                   asp-route-pageSize="@(Model.PageSize)">
                                    &raquo;
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
        <!--訂單列表卡片Start-->

    </div>
</section>

@section Modals {
    <div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="detailModalLabel">付款詳細資料</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="modal-detail-content">
                    <!-- AJAX 載入內容 -->
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('click', async (e) => {
            const btn = e.target.closest('.btn-detail');
            if (!btn) return;

            e.preventDefault();
            const id = btn.dataset.id;
            const content = document.getElementById('modal-detail-content');

            // 載入中樣式 + 開窗
            btn.disabled = true;
            content.innerHTML = `
                <div class="text-center py-5">
                    <div class="spinner-border" role="status" aria-hidden="true"></div>
                    <div class="mt-2">載入中…</div>
                </div>
            `;

            const modalEl = document.getElementById('detailModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();

            try {
                const url = '@Url.Action("Details", "PaymentsHome", new { area = "Payments" })' +
                           '?id=' + encodeURIComponent(id);

                const resp = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!resp.ok) {
                    const msg = resp.status === 404 ? '找不到這筆付款'
                              : resp.status === 403 ? '沒有權限檢視'
                              : `載入失敗（${resp.status}）`;
                    throw new Error(msg);
                }

                const html = await resp.text();
                content.innerHTML = html;

            } catch (err) {
                content.innerHTML = `<div class="text-danger p-3">${err.message}</div>`;
            } finally {
                btn.disabled = false;
            }
        });
    </script>
}