@model RentalManagementPlatformMVC.Areas.Payments.ViewModels.PaymentDetailViewModel

<!-- Header -->
<div class="modal-header border-0">
    <div class="d-flex flex-column">
        <div class="fs-5 fw-semibold">@Html.DisplayNameFor(m => m.PaymentId)</div>
        <div class="text-secondary small">
            @Html.DisplayNameFor(m => m.PaymentId)：<span class="fw-semibold">@Html.DisplayFor(m => m.PaymentId)</span>
            <span class="mx-2">|</span>
            @Html.DisplayNameFor(m => m.OrderNumberSnapshot)：<span class="fw-semibold">@Html.DisplayFor(m => m.OrderNumberSnapshot)</span>
        </div>
    </div>
</div>

<!-- Body -->
<div class="modal-body pt-0">
    <div class="row g-3">
        <!-- 左半：付款基本資訊 -->
        <div class="col-12 col-md-6">
            <div class="border rounded-3 p-3 h-100">
                <div class="text-muted fw-semibold mb-2">
                    <i class="bi bi-cash-coin me-1"></i> 付款資訊
                </div>

                <div class="row small gy-2">
                    <div class="col-5 text-secondary">@Html.DisplayNameFor(m => m.Amount)</div>
                    <div class="col-7 fw-semibold text-end text-md-start">
                        @{
                            // 若你已在 ViewModel 用 [DataType(DataType.Currency)]，也可改用：@Html.DisplayFor(m => m.Amount)
                            var amt = Model.Amount.HasValue ? $"NT$ {Model.Amount.Value:N0}" : "-";
                        }
                        @amt
                    </div>

                    <div class="col-5 text-secondary">@Html.DisplayNameFor(m => m.Method)</div>
                    <div class="col-7 fw-medium">@Html.DisplayFor(m => m.DisplayMethod)</div>

                    <div class="col-5 text-secondary">@Html.DisplayNameFor(m => m.PaidAt)</div>
                    <div class="col-7">@Html.DisplayFor(m => m.PaidAt)</div>

                    <div class="col-5 text-secondary">@Html.DisplayNameFor(m => m.PaymentRef)</div>
                    <div class="col-7">@Html.DisplayFor(m => m.PaymentRef)</div>

                    <div class="col-5 text-secondary">@Html.DisplayNameFor(m => m.Status)</div>
                    <div class="col-7">
                        <span class="badge py-2 px-3
                            @(Model.Status?.ToLower() == "paid" ? "bg-success" :
                              Model.Status?.ToLower() == "pending" ? "bg-warning text-dark" :
                              Model.Status?.ToLower() == "refunded" ? "bg-info text-dark" :
                              Model.Status?.ToLower() == "failed" ? "bg-danger" : "bg-secondary")">
                            @Html.DisplayFor(m => m.DisplayStatus)
                        </span>
                    </div>

                    <div class="col-5 text-secondary">@Html.DisplayNameFor(m => m.PaymentCreatedAt)</div>
                    <div class="col-7">@Html.DisplayFor(m => m.PaymentCreatedAt)</div>
                </div>
            </div>
        </div>

        <!-- 右半：交易紀錄 + 訂房資訊 -->
        <div class="col-12 col-md-6">
            <div class="border rounded-3 p-3 h-100">
                <div class="text-muted fw-semibold mb-2">
                    <i class="bi bi-receipt me-1"></i> @Html.DisplayNameFor(m => m.Transactions)
                </div>

                @if (Model.Transactions == null || !Model.Transactions.Any())
                {
                    <div class="small text-muted">尚無交易紀錄</div>
                }
                else
                {
                    <div class="table-responsive" style="overflow-x: auto; white-space: nowrap;">
                        <table class="table table-bordered table-striped text-center align-middle w-100">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:8%">@Html.DisplayNameFor(m => m.Transactions.First().TransactionId)</th>
                                    <th style="width:15%">@Html.DisplayNameFor(m => m.Transactions.First().Provider)</th>
                                    <th style="width:20%">@Html.DisplayNameFor(m => m.Transactions.First().ProviderTxnId)</th>
                                    <th style="width:10%">@Html.DisplayNameFor(m => m.Transactions.First().ResponseCode)</th>
                                    <th style="width:20%">@Html.DisplayNameFor(m => m.Transactions.First().ResponseMessage)</th>
                                    <th style="width:15%">@Html.DisplayNameFor(m => m.Transactions.First().TxnRef)</th>
                                    <th style="width:12%">@Html.DisplayNameFor(m => m.Transactions.First().TransactionCreatedAt)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var txn in Model.Transactions)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(_ => txn.TransactionId)</td>
                                        <td>@Html.DisplayFor(_ => txn.Provider)</td>
                                        <td>@Html.DisplayFor(_ => txn.ProviderTxnId)</td>
                                        <td>@Html.DisplayFor(_ => txn.ResponseCode)</td>
                                        <td>@Html.DisplayFor(_ => txn.ResponseMessage)</td>
                                        <td>@Html.DisplayFor(_ => txn.TxnRef)</td>
                                        <td>@Html.DisplayFor(_ => txn.TransactionCreatedAt)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <hr class="my-3" />

                <div class="text-muted fw-semibold mb-2">
                    <i class="bi bi-people me-1"></i> 訂房資訊
                </div>

                <div class="row small gy-2">
                    <div class="col-5 text-secondary">@Html.DisplayNameFor(m => m.GuestName)</div>
                    <div class="col-7 fw-medium">@Html.DisplayFor(m => m.GuestName)</div>

                    <div class="col-5 text-secondary">@Html.DisplayNameFor(m => m.RoomTitle)</div>
                    <div class="col-7">@Html.DisplayFor(m => m.RoomTitle)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Footer -->
<div class="modal-footer border-0">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">關閉</button>
</div>