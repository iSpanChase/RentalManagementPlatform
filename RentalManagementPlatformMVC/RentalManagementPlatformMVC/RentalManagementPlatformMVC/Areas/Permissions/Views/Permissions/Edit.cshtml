@model RentalManagementPlatformMVC.Areas.Permissions.ViewModels.PermissionFormVm
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Edit Permission";
}

<div class="content-header mt-3">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h2 class="m-0" style="font-family: 'Segoe UI', 'Microsoft JhengHei', Arial, sans-serif; font-weight: 700; letter-spacing: 1px; color: #2c3e50;">
                編輯權限
                </h2>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline mb-3">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <form method="post" asp-area="Permissions" asp-controller="Permissions" asp-action="Edit">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PermissionId" />

                    <div class="mb-3">
                        <label class="form-label">Perm Code</label>
                        <input asp-for="PermCode" class="form-control" />
                        <span asp-validation-for="PermCode" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Perm Name</label>
                        <input asp-for="PermName" class="form-control" />
                        <span asp-validation-for="PermName" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Module</label>
                            <input asp-for="Module" class="form-control" />
                            <span asp-validation-for="Module" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Action</label>
                            <input asp-for="Action" class="form-control" />
                            <span asp-validation-for="Action" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="text-end gap-2">
                        <button type="submit" class="btn btn-primary">儲存</button>
                        <a class="btn btn-secondary" asp-area="Permissions" asp-controller="Permissions" asp-action="Index" asp-route-id="@Model.PermissionId">返回</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>