@model RentalManagementPlatformMVC.Areas.Permissions.PermissionsDTOs.PermissionDetailDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Permission Details";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Permission 詳細</h3>
        <div class="card-tools">
            <a class="btn btn-sm btn-outline-secondary" asp-area="Permissions" asp-controller="Permissions" asp-action="Edit" asp-route-id="@Model.PermissionId">Edit</a>
            <a class="btn btn-sm btn-outline-info" asp-area="Permissions" asp-controller="Permissions" asp-action="UsedByRoles" asp-route-id="@Model.PermissionId">Used by Roles</a>
            <a class="btn btn-sm btn-secondary" asp-area="Permissions" asp-controller="Permissions" asp-action="Index">返回清單</a>
        </div>
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-2">Perm Code</dt>
            <dd class="col-sm-10">@Model.PermCode</dd>

            <dt class="col-sm-2">Perm Name</dt>
            <dd class="col-sm-10">@Model.PermName</dd>

            <dt class="col-sm-2">Module</dt>
            <dd class="col-sm-10">@Model.Module</dd>

            <dt class="col-sm-2">Action</dt>
            <dd class="col-sm-10">@Model.Action</dd>

            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@Model.Description</dd>

            <dt class="col-sm-2">Created</dt>
            <dd class="col-sm-10">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-2">Updated</dt>
            <dd class="col-sm-10">@Model.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
</div>
