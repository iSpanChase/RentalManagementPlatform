@model RentalManagementPlatformMVC.Areas.Permissions.PermissionsDTOs.PermissionDetailDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "權限詳細資訊";
}

<div class="content-header mt-3">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h2 class="m-0" style="font-family: 'Segoe UI', 'Microsoft JhengHei', Arial, sans-serif; font-weight: 700; letter-spacing: 1px; color: #2c3e50;">
                    權限詳細資訊
                </h2>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline mb-3">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-2">權限代碼</dt>
                    <dd class="col-sm-10">@Model.PermCode</dd>

                    <dt class="col-sm-2">權限名稱</dt>
                    <dd class="col-sm-10">@Model.PermName</dd>

                    <dt class="col-sm-2">權限模組</dt>
                    <dd class="col-sm-10">@Model.Module</dd>

                    <dt class="col-sm-2">權限動作</dt>
                    <dd class="col-sm-10">@Model.Action</dd>

                    <dt class="col-sm-2">權限描述</dt>
                    <dd class="col-sm-10">@Model.Description</dd>

                    <dt class="col-sm-2">建立時間</dt>
                    <dd class="col-sm-10">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-2">修改時間</dt>
                    <dd class="col-sm-10">@Model.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
                <div class="text-end">
                    <a class="btn btn-primary" asp-area="Permissions" asp-controller="Permissions" asp-action="Edit" asp-route-id="@Model.PermissionId">編輯</a>
                    <a class="btn btn-info" asp-area="Permissions" asp-controller="Permissions" asp-action="UsedByRoles" asp-route-id="@Model.PermissionId">使用中的角色</a>
                    <a class="btn btn-secondary" asp-area="Permissions" asp-controller="Permissions" asp-action="Index">返回清單</a>
                </div>
            </div>
        </div>
    </div>
</section>
