@model RentalManagementPlatformMVC.Areas.Permissions.ViewModels.PermissionFormVm
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "新增權限";
}

<div class="content-header mt-3">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h2 class="m-0" style="font-family: 'Segoe UI', 'Microsoft JhengHei', Arial, sans-serif; font-weight: 700; letter-spacing: 1px; color: #2c3e50;">
                    新增權限
                </h2>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline mb-3">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <form method="post" asp-area="Permissions" asp-controller="Permissions" asp-action="Create">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">權限代碼</label>
                        <input asp-for="PermCode" class="form-control" placeholder="ex: Users.Create" />
                        <span asp-validation-for="PermCode" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">權限名稱</label>
                        <input asp-for="PermName" class="form-control" placeholder="顯示名稱，如：新增使用者" />
                        <span asp-validation-for="PermName" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">權限模組</label>
                            <input asp-for="Module" class="form-control" placeholder="Users / Roles / ..." />
                            <span asp-validation-for="Module" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">權限動作</label>
                            <input asp-for="Action" class="form-control" placeholder="View / Browse / Create / Edit / Delete ..." />
                            <span asp-validation-for="Action" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">權限描述</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="text-end gap-2">
                        <button type="submit" class="btn btn-primary">儲存</button>
                        <a class="btn btn-secondary" asp-area="Permissions" asp-controller="Permissions" asp-action="Index">返回</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
