@model RentalManagementPlatformMVC.Areas.Permissions.ViewModels.PermissionFormVm
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Create Permission";
}

<div class="card">
    <div class="card-header"><h3 class="card-title">新增 Permission</h3></div>
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <form method="post" asp-area="Permissions" asp-controller="Permissions" asp-action="Create">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Perm Code</label>
                <input asp-for="PermCode" class="form-control" placeholder="ex: Users.Create" />
                <span asp-validation-for="PermCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Perm Name</label>
                <input asp-for="PermName" class="form-control" placeholder="顯示名稱，如：新增使用者" />
                <span asp-validation-for="PermName" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Module</label>
                    <input asp-for="Module" class="form-control" placeholder="Users / Roles / ..." />
                    <span asp-validation-for="Module" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Action</label>
                    <input asp-for="Action" class="form-control" placeholder="View / Browse / Create / Edit / Delete ..." />
                    <span asp-validation-for="Action" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">儲存</button>
                <a class="btn btn-secondary" asp-area="Permissions" asp-controller="Permissions" asp-action="Index">返回</a>
            </div>
        </form>
    </div>
</div>
