@{
    ViewData["Title"] = "動態報表";
}

<h2>@ViewData["Title"]</h2>

<div>
    <label>選擇報表樣板：</label>
    <select id="reportType">
        <option value="bar">柱狀圖</option>
        <option value="line">折線圖</option>
        <option value="pie">圓餅圖</option>
    </select>

    <label>單位時間跨度：</label>
    <select id="timeUnit">
        <option value="day">一天</option>
        <option value="week">一週</option>
        <option value="month">一個月</option>
        <option value="quarter">一季</option>
        <option value="year">一年</option>
    </select>

    <div id="input-day" class="time-unit-input-block">
        <label>開始日期：</label>
        <input type="date" id="startDate" />
        <label>結束日期：</label>
        <input type="date" id="endDate" />
    </div>

    <div id="input-week" class="time-unit-input-block" style="display:none;">
        <label>開始日期：</label>
        <input type="date" id="startWeekDate" />
        <label>結束日期：</label>
        <input type="date" id="endWeekDate" />
    </div>

    <div id="input-month" class="time-unit-input-block" style="display:none;">
        <label>開始年份：</label>
        <input type="number" id="startMonthYear" min="2024" max="2026" value="2025" />
        <label>開始月份：</label>
        <select id="startMonthMonth">
            <option value="1">一月</option>
            <option value="2">二月</option>
            <option value="3">三月</option>
            <option value="4">四月</option>
            <option value="5">五月</option>
            <option value="6">六月</option>
            <option value="7">七月</option>
            <option value="8">八月</option>
            <option value="9">九月</option>
            <option value="10">十月</option>
            <option value="11">十一月</option>
            <option value="12">十二月</option>
        </select>
        <label>結束年份：</label>
        <input type="number" id="endMonthYear" min="2024" max="2026" value="2025" />
        <label>結束月份：</label>
        <select id="endMonthMonth">
            <option value="1">一月</option>
            <option value="2">二月</option>
            <option value="3">三月</option>
            <option value="4">四月</option>
            <option value="5">五月</option>
            <option value="6">六月</option>
            <option value="7">七月</option>
            <option value="8">八月</option>
            <option value="9">九月</option>
            <option value="10">十月</option>
            <option value="11">十一月</option>
            <option value="12">十二月</option>
        </select>
    </div>

    <div id="input-quarter" class="time-unit-input-block" style="display:none;">
        <label>開始年份：</label>
        <input type="number" id="startQuarterYear" min="2024" max="2026" value="2025" />
        <label>開始季度：</label>
        <select id="startQuarterQuarter">
            <option value="1">第一季</option>
            <option value="2">第二季</option>
            <option value="3">第三季</option>
            <option value="4">第四季</option>
        </select>
        <label>結束年份：</label>
        <input type="number" id="endQuarterYear" min="2024" max="2026" value="2025" />
        <label>結束季度：</label>
        <select id="endQuarterQuarter">
            <option value="1">第一季</option>
            <option value="2">第二季</option>
            <option value="3">第三季</option>
            <option value="4">第四季</option>
        </select>
    </div>

    <div id="input-year" class="time-unit-input-block" style="display:none;">
        <label>開始年份：</label>
        <input type="number" id="startYearInput" min="2024" max="2026" value="2025" />
        <label>結束年份：</label>
        <input type="number" id="endYearInput" min="2024" max="2026" value="2025" />
    </div>

    <button id="btnLoad">載入報表</button>
</div>

<hr />

<canvas id="myChart" width="400" height="200"></canvas>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let baseAddress="https://localhost:7159"
        let chart; // 全域變數，避免重複 new Chart

        $("#timeUnit").on("change", function(){
            let val = $(this).val();
            $(".time-unit-input-block").hide(); // 先隱藏全部
            $("#input-" + val).show(); // 顯示對應的輸入區塊
        });

        $("#btnLoad").on("click", function (){
            fetchPostChart();
        });

        function formatDateLocal(date) {
          let y = date.getFullYear();
          let m = String(date.getMonth() + 1).padStart(2, "0");
          let d = String(date.getDate()).padStart(2, "0");
          return `${y}-${m}-${d}`;
        }

        //將圖表類型、時間跨度、開始時間、結束時間對server進行ajax要求產生圖表
        function fetchPostChart(){
            let data = new FormData();
            let type =$("#reportType").val();
            let timeUnit = $("#timeUnit").val();
            data.append("Type",type);
            data.append("TimeUnit",timeUnit);

            let start;
            let end;
            switch(timeUnit){
                case "day":
                    start = $("#startDate").val();
                    end = $("#endDate").val();
                    break;
                case "week":
                    start = $("#startWeekDate").val();
                    end = $("#endWeekDate").val();
                    alert(start);
                    break;
                case "month":
                    start = formatDateLocal(new Date(parseInt($("#startMonthYear").val()), parseInt($("#startMonthMonth").val())-1,1));
                    end = formatDateLocal(new Date(parseInt($("#endMonthYear").val()), parseInt($("#endMonthMonth").val())-1,1));
                    break;
                case "quarter":
                    start = formatDateLocal(new Date(parseInt($("#startQuarterYear").val()),parseInt($("#startQuarterQuarter").val())*3-2-1,1));
                    end = formatDateLocal(new Date(parseInt($("#endQuarterYear").val()),parseInt($("#endQuarterQuarter").val())*3-2-1,1));
                    break;
                case "year":
                    start = formatDateLocal(new Date(parseInt($("#startYearInput").val()),0,1).toISOString());
                    end = formatDateLocal(new Date(parseInt($("#endYearInput").val()),0,1).toISOString());
                    break;
                    
            }

            data.append("Start",start);
            data.append("End",end);

            fetch(`${baseAddress}/ReportForm/ReportForm/GetChartData`,{
                method:"POST",
                body:data,
            }).then(function(result){
                if(result.ok){
                    return result.json();
                }
            }).then(function(data){
                if (chart) {
                        chart.destroy();
                    }

                    let ctx = document.getElementById('myChart');
                    chart = new Chart(ctx, {
                        type: type, // 使用者選的
                        data: {
                            labels: data.labels,
                            datasets: [{
                                label: data.label,
                                data: data.data,
                                borderWidth: 1,
                                backgroundColor: data.colors
                            }]
                        },
                        options: {
                            responsive: true,
                            scales: {
                                y: {
                                    beginAtZero: true
                                }
                            }
                        }
                    });
            }).catch(function(err){
                alert(err.message);
            })
        }
    </script>
}