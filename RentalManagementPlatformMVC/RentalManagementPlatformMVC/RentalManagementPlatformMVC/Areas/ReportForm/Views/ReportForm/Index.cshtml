@using RentalManagementPlatformMVC.Areas.ReportForm.ViewModels
@using RentalManagementPlatformMVC.Areas.ReportForm.ViewModels.Query

@{
    var startDate = DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd");
    var endDate = DateTime.Today.ToString("yyyy-MM-dd");
}

@{
    var cards = new List<BookingAmountTrendQuery>
    {
    };
}

<div class="d-flex align-items-center gap-2 mb-3">
    <button id="btnAddCard" class="btn btn-primary">新增卡片</button>

    <select id="favSelect" class="form-select" style="width:auto; min-width: 220px;">
        <option value="">（選擇我的最愛）</option>
    </select>

    <button id="btnFavSave" class="btn btn-outline-secondary">加入我的最愛</button>
    <button id="btnFavLoad" class="btn btn-outline-secondary">載入我的最愛</button>
    <button id="btnFavDelete" class="btn btn-outline-danger">刪除我的最愛</button>
</div>

<div id="reportControls" hidden>
    <label>報表種類：</label>
    <select id="globalReportId">
        <!-- 由 JS registry 動態填入 <option> -->
    </select>

    <div class="mt-2">
        <label class="form-label">卡片名稱</label>
        <input id="cardTitleInput" class="form-control" placeholder="例如：近 12 週訂單金額趨勢">
    </div>

    <label>圖表類型：</label>
    <select id="globalReportType">
        <option value="bar">柱狀圖</option>
        <option value="line">折線圖</option>
        <option value="pie">圓餅圖</option>
    </select>

    <label>時間跨度：</label>
    <select id="globalTimeUnit">
        <option value="day">天</option>
        <option value="week">周</option>
        <option value="month">月</option>
        <option value="quarter">季</option>
        <option value="year">年</option>
    </select>

    <!-- 時間選擇器 (只顯示一組，根據 timeUnit 切換) -->
    <div id="timeSelectors">
        <!-- day -->
        <div class="time-unit-input-block input-day">
            <label>開始日期：</label>
            <input type="date" class="startDate" value="@startDate" />
            <label>結束日期：</label>
            <input type="date" class="endDate" value="@endDate" />
        </div>

        <!-- week -->
        <div class="time-unit-input-block input-week" hidden>
            <label>開始年份：</label>
            <input type="number" class="startWeekYear" min="2024" max="2026" value="2025" />
            <label>開始週數：</label>
            <select class="startWeekWeek"></select>
            <label>結束年份：</label>
            <input type="number" class="endWeekYear" min="2024" max="2026" value="2025" />
            <label>結束週數：</label>
            <select class="endWeekWeek"></select>
        </div>

        <!-- month -->
        <div class="time-unit-input-block input-month" hidden>
            <label>開始年份：</label>
            <input type="number" class="startMonthYear" min="2024" max="2026" value="2025" />
            <label>開始月份：</label>
            <select class="startMonthMonth">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m">@($"{m}月")</option>
                }
            </select>
            <label>結束年份：</label>
            <input type="number" class="endMonthYear" min="2024" max="2026" value="2025" />
            <label>結束月份：</label>
            <select class="endMonthMonth">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m">@($"{m}月")</option>
                }
            </select>
        </div>

        <!-- quarter -->
        <div class="time-unit-input-block input-quarter" hidden>
            <label>開始年份：</label>
            <input type="number" class="startQuarterYear" min="2024" max="2026" value="2025" />
            <label>開始季度：</label>
            <select class="startQuarterQuarter">
                <option value="1">第一季</option>
                <option value="2">第二季</option>
                <option value="3">第三季</option>
                <option value="4">第四季</option>
            </select>
            <label>結束年份：</label>
            <input type="number" class="endQuarterYear" min="2024" max="2026" value="2025" />
            <label>結束季度：</label>
            <select class="endQuarterQuarter">
                <option value="1">第一季</option>
                <option value="2">第二季</option>
                <option value="3">第三季</option>
                <option value="4">第四季</option>
            </select>
        </div>

        <!-- year -->
        <div class="time-unit-input-block input-year" hidden>
            <label>開始年份：</label>
            <input type="number" class="startYearInput" min="2024" max="2026" value="2025" />
            <label>結束年份：</label>
            <input type="number" class="endYearInput" min="2024" max="2026" value="2025" />
        </div>
    </div>

    <!-- 不同報表專屬的篩選條件動態出現在這裡 -->
    <div id="reportFilterPanel"></div>

    <div class="d-flex gap-2 mt-3">
        <button id="btnConfirmAdd" class="btn btn-success">新增</button>
        <button id="btnConfirmEdit" class="btn btn-success" hidden>確認編輯</button>
        <button id="btnCancelPanel" class="btn btn-outline-secondary">取消</button>
    </div>
</div>

<div id="reportCardsRow" class="row g-3">
    <!-- 動態新增卡片 -->
</div>

@section Scripts {
    <!-- 你原先就有的全域資源，放在 Layout 或這裡皆可 -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script src="~/js/reportform/time-format.js"></script>
	<script src="~/js/reportform/week-select-generate.js"></script>
	<script src="~/js/reportform/report-time-selection.js"></script>
	<script src="~/js/reportform/report-config.js"></script>
	<script src="~/js/reportform/report/booking-count-trend.js"></script>
	<script src="~/js/reportform/report/booking-amount-trend.js"></script>
    <script src="~/js/reportform/report/user-count-trend.js"></script>
	<script src="~/js/reportform/report/user-create-count-trend.js"></script>
    <script src="~/js/reportform/reportchartcard.init.js"></script>
	<script src="~/js/reportform/report-dashboard.ui.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function(){
          ReportConfig.initControls(); // 會把 #globalReportId 塞滿、並渲染 #reportFilterPanel
        });
    </script>
}