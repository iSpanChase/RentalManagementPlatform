@model RentalManagementPlatformMVC.Areas.ReportForm.ViewModels.Anomaly.RuleVM;
@{
    ViewData["Title"] = "新增規則";
    var targetTypes = (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.TargetTypes;
    var ops = (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Operators;
}


<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
  </div>
  <div class="card shadow-sm">
    <div class="card-body">
<form asp-action="Create" method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="col-md-4">
        <label asp-for="RuleName" class="form-label"></label>
        <input asp-for="RuleName" class="form-control" />
        <span asp-validation-for="RuleName" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="TargetType" class="form-label">監控指標</label>
        <select asp-for="TargetType" class="form-select" asp-items="targetTypes"></select>
        <span asp-validation-for="TargetType" class="text-danger"></span>
    </div>

    <div class="col-md-1">
        <label asp-for="ConditionExpression" class="form-label">條件</label>
        <select asp-for="ConditionExpression" class="form-select" asp-items="ops"></select>
        <span asp-validation-for="ConditionExpression" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="ThresholdValue" class="form-label">門檻</label>
        <input asp-for="ThresholdValue" class="form-control" />
        <span asp-validation-for="ThresholdValue" class="text-danger"></span>
    </div>

    <div class="col-md-1 d-flex align-items-end">
        <div class="form-check">
            <input class="form-check-input" asp-for="IsActive" />
            <label class="form-check-label fw-bold form-label" asp-for="IsActive">啟用</label>
        </div>
    </div>

    <div class="col-12">
        <button class="btn btn-primary" type="submit">儲存</button>
        <a asp-action="Index" class="btn btn-outline-secondary">返回</a>
    </div>
    @Html.AntiForgeryToken()
</form>


    </div>
  </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
