@model IEnumerable<RentalManagementPlatformMVC.Models.AnomalyRule>
@{
	ViewData["Title"] = "警示規則";
	var map = (System.Collections.Generic.Dictionary<string, string>)ViewBag.TargetTypeMap;
}


<div class="container py-4">
	<div class="d-flex align-items-center justify-content-between mb-3">
		<h1 class="h3 mb-0">@ViewData["Title"]</h1>
		<div class="d-flex gap-2">
			<a class="btn btn-primary" asp-action="Create">新增規則</a>
		</div>
	</div>
	<div class="d-flex justify-content-between align-items-center mb-3">
	</div>

	@if (TempData["msg"] != null)
	{
		<div class="alert alert-success">@TempData["msg"]</div>
	}

	<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="deleteConfirmLabel">確認刪除</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
				</div>
				<div class="modal-body">
					規則 [ @(TempData["RuleName"]) ] 已有紀錄引用
					<br>
					將連帶記錄一同刪除，確定要刪除嗎？
				</div>
				<div class="modal-footer">
					<form asp-action="DeleteConfirmed" method="post">
						<input type="hidden" name="id" value="@TempData["DeleteId"]" />
						<button type="submit" class="btn btn-danger">確定</button>
					</form>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
				</div>
			</div>
		</div>
	</div>

	<div class="card shadow-sm">
		<div class="card-body p-0">
			<div class="table-responsive">
				<table class="table table-striped table-hover align-middle table-sm">
					<thead class="table-light">
						<tr>
							<th>啟用</th>
							<th>名稱</th>
							<th>監控指標</th>
							<th>條件</th>
							<th>門檻</th>
							<th>建立時間 (UTC)</th>
							<th style="width:180px;"></th>
						</tr>
					</thead>
					<tbody>
						@foreach (var r in Model)
						{
							<tr class="@(r.IsActive.Value ? "" : "table-secondary")">
								<td>
									<form asp-action="Toggle" asp-route-id="@r.RuleId" method="post" class="d-inline">
										<button type="submit" class="btn btn-sm @(r.IsActive.Value ? "btn-success" : "btn-outline-secondary")">
											@(r.IsActive.Value ? "啟用中" : "已停用")
										</button>
										@Html.AntiForgeryToken()
									</form>
								</td>
								<td><a asp-controller="AnomalyLog" asp-action="Index" asp-route-Id="@r.RuleId">@r.RuleName</a></td>
								<td>@(map.TryGetValue(r.TargetType, out var t) ? t : r.TargetType)</td>
								<td>@r.ConditionExpression</td>
								<td>@r.ThresholdValue</td>
								<td>@r.CreatedAt.Value.ToString("yyyy-MM-dd HH:mm")</td>
								<td class="text-end">
									<form asp-action="Delete" asp-route-id="@r.RuleId" method="post" class="d-inline">
										<button class="btn btn-sm btn-outline-danger" type="submit">刪除</button>
										@Html.AntiForgeryToken()
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>
@section Scripts {
	<script>
		(function () {
			const es = new EventSource('/ReportForm/AnomalyEvents/Stream');

			es.onmessage = (ev) => {
			try {
				const msg = JSON.parse(ev.data);
				alert(`[${msg.type}] 異常警示：對象：${msg.targetId}\n_${msg.value}發生${msg.ruleName ?? msg.ruleId}異常`);
			} catch (e) {
				console.log('Anomaly event:', ev.data);
			}
			};

			es.onerror = (err) => {
			console.warn('Anomaly event stream error. Will auto-reconnect by EventSource...', err);
			// EventSource 會自動重連，不用自己處理
			};
		})();

		document.addEventListener("DOMContentLoaded", function () {
			var needConfirm = "@TempData["ShowDeleteConfirm"]" === "True";
			if (needConfirm) {
				var modal = new bootstrap.Modal(document.getElementById("deleteConfirmModal"));
				modal.show();
			}
		});
	</script>
}
