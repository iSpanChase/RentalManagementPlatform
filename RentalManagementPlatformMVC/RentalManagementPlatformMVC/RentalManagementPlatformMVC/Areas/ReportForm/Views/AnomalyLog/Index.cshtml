@using RentalManagementPlatformMVC.Areas.ReportForm.Anomaly
@using RentalManagementPlatformMVC.Areas.ReportForm.Controllers;
@model PagedResult<Log>
@{
	ViewData["Title"] = "警示紀錄";
	var map = (System.Collections.Generic.Dictionary<string, string>)ViewBag.TargetTypeMap;
}


<div class="container py-4">
	<div class="d-flex align-items-center justify-content-between mb-3">
		<h1 class="h3 mb-0">@ViewData["Title"]</h1>
		<div class="d-flex gap-2">
		</div>
	</div>
	@if (TempData["msg"] != null)
	{
		<div class="alert alert-success">@TempData["msg"]</div>
	}

	<div class="card shadow-sm">
		<div class="card-body p-0">
			<div class="table-responsive">
				<table class="table table-striped table-hover align-middle table-sm">
					<thead class="table-light">
						<tr>
							<th>套用的規則</th>
							<th>檢測目標類型</th>
							<th>檢測目標ID</th>
							<th>實際檢測數值</th>
							<th>條件</th>
							<th>門檻</th>
							<th>建立時間 (UTC)</th>
							<th>已解決</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var r in Model.Items)
						{
							<tr class="table-secondary">
								<td>@r.RuleName</td>
								<td>@(map.TryGetValue(r.TargetType, out var t) ? t : r.TargetType)</td>
								<td>@r.TargetId</td>
								<td>@r.RealValue</td>
								<td>@r.ConditionExpression</td>
								<td>@r.ThresholdValue</td>
								<td>@r.CreateTime.Value.ToString("yyyy-MM-dd HH:mm")</td>
								<td>@(r.Solved ? "O":"×")</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
	<nav aria-label="頁碼" class="mt-3">
		<ul class="pagination">
			<li class="page-item @(Model.HasPrev ? "" : "disabled")">
				<a class="page-link"
				   asp-action="Index"
				   asp-route-id="@Model.RuleIdFilter"
				   asp-route-page="@(Model.Page - 1)"
				   asp-route-pageSize="@Model.PageSize">上一頁</a>
			</li>

			@for (var p = 1; p <= Model.TotalPages; p++)
			{
				<li class="page-item @(p == Model.Page ? "active" : "")">
					<a class="page-link"
					   asp-action="Index"
					   asp-route-id="@Model.RuleIdFilter"
					   asp-route-page="@p"
					   asp-route-pageSize="@Model.PageSize">@p</a>
				</li>
			}

			<li class="page-item @(Model.HasNext ? "" : "disabled")">
				<a class="page-link"
				   asp-action="Index"
				   asp-route-id="@Model.RuleIdFilter"
				   asp-route-page="@(Model.Page + 1)"
				   asp-route-pageSize="@Model.PageSize">下一頁</a>
			</li>
		</ul>
	</nav>
	@if (TempData["msg"] != null)
	{
		<div class="alert alert-success">@TempData["msg"]</div>
	}
</div>
