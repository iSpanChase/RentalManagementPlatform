@model IEnumerable<RentalManagementPlatformMVC.Areas.FAQ.ViewModels.FeedbackVM>
@{
    var articleId = (int?)ViewBag.ArticleId ?? 0;
}
<div class="mb-2 small text-muted">Article ID: @articleId</div>

@if (!Model.Any())
{
    <div class="alert alert-info">目前沒有回饋。</div>
}
else
{
    <table class="table table-sm table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th style="width:90px;">時間</th>
                <th style="width:90px;">情緒</th>
                <th>原因</th>
                <th style="width:220px;">Email</th>
                <th style="width:120px;">升級為工單</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in Model)
            {
                <tr>
                    <td>@(f.CreatedAt?.ToString("MM/dd HH:mm"))</td>
                    <td>@f.Sentiment</td>
                    <td>@f.Reason</td>
                    <td>@f.ContactEmail</td>
                    <td>@(f.EscalatedToTicket == true ? "是" : "否")</td>
                </tr>
            }
        </tbody>
    </table>
}
