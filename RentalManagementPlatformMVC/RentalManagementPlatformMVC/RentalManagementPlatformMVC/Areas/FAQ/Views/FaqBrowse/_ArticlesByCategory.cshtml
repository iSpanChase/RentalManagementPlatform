@model List<ArticleRowVM>

@if (Model == null || !Model.Any())
{
    <div class="text-muted">此分類目前沒有文章。</div>
}
else
{
    <table class="table table-sm align-middle">
        <thead class="table-light">
            <tr>
                <th class="text-center" style="width:2rem;">置頂</th>
                <th>標題</th>
                <th style="width:10rem;">發佈</th>
                <th class="text-end" style="width:8rem;">Helpful</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td class="text-center">@(a.IsPinned == true ? "★" : "")</td>
                    <td>
                        <a asp-area="FAQ" asp-controller="FaqArticles" asp-action="Details"
                           asp-route-id="@a.FaqArticlesId">@a.Title</a>
                    </td>
                    <td>@(a.PublishedAt?.ToString("yyyy/MM/dd HH:mm"))</td>
                    <td class="text-end">
                        <span class="text-success me-1">@a.HelpfulYes.GetValueOrDefault()</span> /
                        <span class="text-danger">@a.HelpfulNo.GetValueOrDefault()</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
