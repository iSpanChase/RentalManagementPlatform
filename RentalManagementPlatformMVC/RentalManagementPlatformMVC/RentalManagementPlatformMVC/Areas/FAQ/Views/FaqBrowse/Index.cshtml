@model List<CategoryVM>

<div class="accordion" id="catAccordion">
    @foreach (var p in Model)
    {
        var pid = $"p{p.CategoryId}";
        <div class="accordion-item">
            <h2 class="accordion-header" id="h-@pid">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse" data-bs-target="#col-@pid">
                    @p.Name
                </button>
            </h2>
            <div id="col-@pid" class="accordion-collapse collapse" data-bs-parent="#catAccordion">
                <div class="accordion-body">

                    <div class="accordion" id="child-acc-@pid">
                        @foreach (var ch in p.Children)
                        {
                            var cid = $"c{ch.CategoryId}";
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="h-@cid">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#col-@cid">
                                        @ch.Name
                                        <span class="badge bg-secondary ms-2">@ch.ArticleCount</span>
                                    </button>
                                </h2>
                                <div id="col-@cid" class="accordion-collapse collapse" data-bs-parent="#child-acc-@pid">
                                    <div class="accordion-body">
                                        <div class="articles-placeholder"
                                             data-category-id="@ch.CategoryId"
                                             data-loaded="0">
                                            <div class="text-muted small">展開時載入文章…</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('catAccordion')
          .addEventListener('shown.bs.collapse', function (e) {
            const pane   = e.target;
            const holder = pane.querySelector('.articles-placeholder');
            if (!holder || holder.dataset.loaded === "1") return;

            const catId = holder.dataset.categoryId;
            const url   = '@Url.Action("ArticlesByCategory", "FaqBrowse", new { area = "FAQ" })'
                        + '?id=' + encodeURIComponent(catId);

            holder.innerHTML = '<div class="text-center py-2"><div class="spinner-border spinner-border-sm"></div><span class="ms-2">載入中…</span></div>';

            fetch(url)
              .then(r => r.text())
              .then(html => {
                holder.innerHTML = html;
                holder.dataset.loaded = "1";
              })
              .catch(() => {
                holder.innerHTML = '<div class="text-danger">載入失敗</div>';
              });
        });
    </script>
}

