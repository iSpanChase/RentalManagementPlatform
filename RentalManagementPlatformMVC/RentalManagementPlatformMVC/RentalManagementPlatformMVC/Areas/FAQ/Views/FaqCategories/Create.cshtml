@model RentalManagementPlatformMVC.Areas.FAQ.ViewModels.FaqCategoryFormVM
@{
    var isEdit = Model.FaqCategoriesId.HasValue;
    ViewData["Title"] = isEdit ? "編輯分類" : "新增分類";
}
<h3>@ViewData["Title"]</h3>
<hr />
<form method="post" class="mt-3">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">父分類</label>
        <select asp-for="ParentId" asp-items="Model.ParentOptions" class="form-select">
            <option value="">(無)</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">儲存</button>
    <a asp-area="FAQ" asp-controller="FaqCategories" asp-action="Index" class="btn btn-link">返回</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
