@{
    ViewData["Title"] = "FAQ 分類管理";
}
<h3>@ViewData["Title"]</h3>

<div class="mb-3 text-end">
    <button class="btn btn-primary" id="btnCreateParent">新增父分類</button>
</div>

<!-- 上方：父分類 -->
<div id="parentPane"></div>

<hr />

<!-- 下方：子分類 -->
<div id="childrenPane" class="mt-3">
    <div class="text-muted">請選取上方父分類</div>
</div>

<div id="modalHost"></div>

@section Scripts {
    <script>
        function loadParents(){
            $("#parentPane").load("@Url.Action("Parents", "FaqCategories", new { area = "FAQ" })");
        }
        function loadChildren(pid){
            $("#childrenPane").load("@Url.Action("Children", "FaqCategories", new { area = "FAQ" })"+"?parentId="+pid);
        }
        $(function(){
            loadParents();

            // 點選父分類 → 載入子分類
            $("#parentPane").on("click",".parent-item",function(){
                $(".parent-item").removeClass("active");
                $(this).addClass("active");
                const pid = $(this).data("id");
                loadChildren(pid);
            });

            $("#btnCreateParent").on("click",function(){
                $("#modalHost").load("@Url.Action("CreateParent", "FaqCategories", new { area = "FAQ" })", function(){
                    $("#_modal").modal("show");
                });
            });
        });
    </script>
}
