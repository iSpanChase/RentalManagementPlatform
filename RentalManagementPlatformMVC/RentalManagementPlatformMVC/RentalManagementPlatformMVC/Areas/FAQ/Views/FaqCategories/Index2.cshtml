@{
    ViewData["Title"] = "FAQ 分類管理";
    Layout = "~/Views/Shared/_Layout.cshtml"; // 依專案調整
}
<style>
    .parent-list .parent-item.active {
        background: #eef6ff;
        border-color: #bcdcff;
    }
</style>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">@ViewData["Title"]</h3>
        <button class="btn btn-primary" id="btnCreateParent">新增父分類</button>
    </div>
    <div class="card-body">

        <!-- 上方父分類 -->
        <div id="parentPane" class="parent-list mb-3">
            <div class="text-muted">載入中…</div>
        </div>

        <hr />

        <!-- 下方子分類 -->
        <div id="childrenPane" class="mt-3">
            <div class="text-muted">請先選取上方父分類</div>
        </div>

    </div>
</div>

<!-- Modal 容器 -->
<div id="modalHost"></div>

@section Scripts {
    <script>
        // === 僅在本頁覆寫安全版 createSparklineChart：不動模板檔 ===
        (function () {
          if (!window.createSparklineChart) {
            window.createSparklineChart = function(){ return Promise.resolve(); };
          }
          const _origCreate = window.createSparklineChart;
          window.createSparklineChart = function(selector, data, options){
            try {
              const el = (typeof selector === 'string') ? document.querySelector(selector) : selector;
              if (!el) return Promise.resolve(); // 本頁沒放對應圖表 → 靜默
              return _origCreate.apply(this, arguments);
            } catch (e) { return Promise.resolve(); }
          };
        })();
    </script>

    <script>
        function loadParents(){
          $("#parentPane").load("@Url.Action("Parents", "FaqCategories", new { area = "FAQ" })", function(){
            const $first = $("#parentPane .parent-item").first();
            if ($first.length){ $first.trigger("click"); }
          });
        }
        function loadChildren(pid){
          $("#childrenPane").load("@Url.Action("Children", "FaqCategories", new { area = "FAQ" })" + "?parentId=" + pid);
        }
        function openModal(url){
          $("#modalHost").load(url, function(){ $("#_modal").modal("show"); });
        }

        $(function(){
          loadParents();

          // 點父分類 → 載入子分類
          $("#parentPane").on("click",".parent-item", function(){
            $("#parentPane .parent-item").removeClass("active");
            $(this).addClass("active");
            const pid = $(this).data("id");
            loadChildren(pid);
          });

          // 新增父分類
          $("#btnCreateParent").on("click", function(){
            openModal("@Url.Action("CreateParent", "FaqCategories", new { area = "FAQ" })");
          });

          // Modal 內表單（Create/Edit/Delete）Ajax 提交
          $("#modalHost").on("submit", "form", function(e){
            e.preventDefault();
            const $form = $(this);
            $.ajax({
              type: "POST",
              url: $form.attr("action"),
              data: $form.serialize(),
              success: function(res){
                if (res && res.ok){
                  $("#_modal").modal("hide");
                  const activeId = $("#parentPane .parent-item.active").data("id");
                  loadParents();
                  if (activeId){ loadChildren(activeId); }
                } else {
                  $("#_modal .modal-content").html(res); // 驗證失敗回局部視圖
                }
              },
              error: function(xhr){ alert(xhr.responseText || "發生錯誤"); }
            });
          });

          // 關閉後清空 Modal 容器
          $("#modalHost").on("hidden.bs.modal","#_modal", function(){ $("#modalHost").empty(); });
        });
    </script>
}
