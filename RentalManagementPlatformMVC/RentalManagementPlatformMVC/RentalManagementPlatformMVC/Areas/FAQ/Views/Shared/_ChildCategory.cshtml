<div class="card p-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">父分類</label>
            <select id="parentDropdown" class="form-select"></select>
        </div>
        <div class="col-md-5">
            <label class="form-label">子分類名稱</label>
            <input id="childName" class="form-control" />
            <input id="childId" type="hidden" />
        </div>
        <div class="col-md-3">
            <button id="btnSaveChild" class="btn btn-primary w-100">新增/更新</button>
        </div>
    </div>

    <hr />
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead><tr><th>ID</th><th>父分類</th><th>子分類</th><th>操作</th></tr></thead>
            <tbody id="childList"></tbody>
        </table>
    </div>
</div>