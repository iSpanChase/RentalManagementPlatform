@model IEnumerable<FaqArticleViewModel>
@{
    var page = (int)(ViewBag.Page ?? 1); var size = (int)(ViewBag.Size ?? 10);
    var total = (int)(ViewBag.Total ?? 0); var pages = (int)Math.Ceiling(total / (double)size);
}

<form method="get" class="mb-3 d-flex gap-2">
    <input name="keyword" class="form-control" placeholder="關鍵字" value="@Context.Request.Query["keyword"]" />
    <button class="btn btn-primary">搜尋</button>
    <a asp-action="Create" class="btn btn-success ms-auto">新增</a>
</form>

<table class="table table-striped">
    <thead><tr><th>置頂</th><th>標題</th><th>摘要</th><th></th></tr></thead>
    <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@(x.IsPinned.Value ? "★" : "")</td>
                <td>@x.Title</td>
                <td>@x.Summary</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@x.FaqArticlesId" class="btn btn-sm btn-outline-secondary">編輯</a>
                    <a asp-action="Details" asp-route-id="@x.FaqArticlesId" class="btn btn-sm btn-outline-info">檢視</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= pages; i++)
        {
            <li class="page-item @(i == page ? "active" : "")">
                <a class="page-link" asp-route-page="@i" asp-route-size="@size"
                   asp-route-keyword="@Context.Request.Query["keyword"]">@i</a>
            </li>
        }
    </ul>
</nav>