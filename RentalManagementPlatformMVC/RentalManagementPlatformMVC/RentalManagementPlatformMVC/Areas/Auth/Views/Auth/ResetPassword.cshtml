@model ResetPasswordVm
@{
    ViewData["Title"] = "重設密碼";
}
<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header"><strong>重設密碼</strong></div>
            <div class="card-body">
                <form method="post" asp-area="Auth" asp-action="ResetPassword">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Token" />

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-area="Auth" asp-action="Login" class="btn btn-outline-secondary">回登入</a>
                        <button type="submit" class="btn btn-primary">設定新密碼</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
