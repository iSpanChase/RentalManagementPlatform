@model ForgotPasswordVm
@{
    ViewData["Title"] = "忘記密碼";
}
<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header"><strong>忘記密碼</strong></div>
            <div class="card-body">
                <p class="text-muted">請輸入註冊時的 Email，我們會寄送重設密碼連結。</p>

                <form method="post" asp-area="Auth" asp-action="ForgotPassword">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-area="Auth" asp-action="Login" class="btn btn-outline-secondary">回登入</a>
                        <button type="submit" class="btn btn-primary">送出</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
