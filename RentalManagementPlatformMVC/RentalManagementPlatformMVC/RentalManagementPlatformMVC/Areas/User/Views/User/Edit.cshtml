@model RentalManagementPlatformMVC.UserDTOs.UpdateUserDto

@{
    ViewData["Title"] = "編輯使用者";
    var username = ViewBag.Username as string;
}
<h2>編輯使用者</h2>

<div class="mb-2 text-muted">帳號：<strong>@username</strong></div>

<form asp-area="User" asp-controller="User" asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">姓名</label>
                <input class="form-control" asp-for="Name" />
                <span class="text-danger" asp-validation-for="Name"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" asp-for="Email" />
                <span class="text-danger" asp-validation-for="Email"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">性別</label>
                <input class="form-control" asp-for="Gender" />
            </div>
            <div class="mb-3">
                <label class="form-label">生日</label>
                <input type="date" class="form-control" asp-for="BirthDate" value="@(Model.BirthDate?.ToString("yyyy-MM-dd"))" />
            </div>
        </div>

        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">電話</label>
                <input class="form-control" asp-for="Phone" />
            </div>
            <div class="mb-3">
                <label class="form-label">地址</label>
                <input class="form-control" asp-for="Address" />
            </div>
            <div class="mb-3">
                <label class="form-label">點數</label>
                <input class="form-control" asp-for="Point" type="number" />
            </div>
            <div class="mb-3 form-check">
                <input class="form-check-input" asp-for="AutoSubscribe" />
                <label class="form-check-label" for="AutoSubscribe">自動訂閱</label>
            </div>
            <div class="mb-3 form-check">
                <input class="form-check-input" asp-for="Isverified" />
                <label class="form-check-label" for="IsVerified">已驗證</label>
            </div>
            <div class="mb-3">
                <label class="form-label">大頭貼 URL（選填）</label>
                <input class="form-control" asp-for="ProfileImageurl" />
            </div>
        </div>
    </div>

    <button class="btn btn-primary" type="submit">儲存</button>
    <a class="btn btn-secondary" asp-area="User" asp-controller="User" asp-action="Index">返回</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
