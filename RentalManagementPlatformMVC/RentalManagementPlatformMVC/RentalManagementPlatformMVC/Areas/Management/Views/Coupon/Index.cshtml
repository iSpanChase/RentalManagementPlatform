@model IEnumerable<RentalManagementPlatformMVC.Areas.Management.ViewModels.CouponListItemVm>

@{
        ViewData["Title"] = "優惠券管理";
        int totalCount = Convert.ToInt32(ViewData["TotalCount"]);
        int pageSize = Convert.ToInt32(ViewData["PageSize"]);
        int pageIndex = Convert.ToInt32(ViewData["PageIndex"]);
        int totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
    }
<div class="content-wrapper">
    <div class="container">
        <div class="mx-auto mt-3" style="max-width: 1200px;">
            <h2 class="mb-4">優惠券管理</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <!-- 搜尋 -->
    <form method="get" class="d-flex align-items-center">
        <input type="text" name="keyword" class="form-control form-control-sm me-1" style="width: 200px;" placeholder="搜尋..." />
        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-search"></i> 搜尋 </button>
     </form>
    <div class="btn-group">
        <form asp-area="Management" asp-controller="CouponGuest" asp-action="Index" method="get" class="me-2">
            <button type="submit" class="btn btn-sm btn-outline-info"><i class="bi bi-journal-text"></i> 查看發放紀錄</button>
        </form>
           <form asp-area="Management" asp-controller="CouponGrant" asp-action="Grant" method="get" class="me-2">
            <button type="submit" class="btn btn-sm btn-outline-info"><i class="bi bi-journal-text"></i> 發放優惠券</button>
        </form>

        <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#createModal"><i class="bi bi-plus-circle"></i> 新增優惠券</button>
    </div>
</div>

<!-- 優惠券表格 -->
<table class="table table-striped table-bordered table-sm text-nowrap" style="font-size: 0.85rem;">
    <thead class="table-dark">
        <tr>
            <th>名稱</th>
            <th>折扣碼</th>
            <th>折扣方式</th>
            <th>說明</th>
            <th>折扣額度</th>
            <th>最低消費</th>
            <th>最短租期</th>
            <th>最長租期</th>
            <th>租期(起)</th>
            <th>租期(迄)</th>
            <th>到期日</th>
            <th>已刪除</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)//對應到ViewModel的顯示
        {
            <tr>
                <td>@item.CouponName</td> 
                <td>@item.DiscountCode</td>
                <td>@item.DiscountMethod</td>
                <td>@item.Description</td>
                <td>@item.DiscountQuotaDisplay</td>
                <td>@item.LowSpendDisplay</td>
                <td>@item.MinRentalPeriod</td>
                <td>@item.MaxRentalPeriod</td>
                <td>@item.StartRentalPeriodDisplay</td>
                <td>@item.EndRentalPeriodDisplay</td>
                <td>@item.EndAtDisplay</td>
                <td>
                    <span class="badge @(item.IsDeleted ? "bg-danger" : "bg-success")">
                        @(item.IsDeleted ? "已刪除" : "正常")
                    </span>
                </td>
                <td>
                    <!-- 編輯按鈕 -->
                    <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#editModal-@item.CouponId"><i class="bi bi-pencil-square"></i> 編輯</button>
                    <!-- 刪除按鈕 -->
                    <form asp-action="Delete" asp-route-id="@item.CouponId" method="post" class="d-inline">
                    <button type="submit" class="btn btn-danger" onclick="return confirm('確定要刪除這筆資料嗎？')"><i class="bi bi-trash"></i> 刪除 </button>
                </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    int maxPagesToShow = 6; // 顯示的最大頁碼數
    int halfPages = maxPagesToShow / 2;

    int startPage = Math.Max(1, pageIndex - halfPages);
    int endPage = Math.Min(totalPages, pageIndex + halfPages);

    // 保持最大頁碼數，如果到達前或後邊界，自動補齊另一側
    if (endPage - startPage + 1 < maxPagesToShow)
    {
        if (startPage == 1)
        {
            endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);
        }
        else if (endPage == totalPages)
        {
            startPage = Math.Max(1, endPage - maxPagesToShow + 1);
        }
    }
}

<nav>
    <ul class="pagination justify-content-center">
        <!-- 上一頁 -->
        <li class="page-item @(pageIndex <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(pageIndex - 1)" asp-route-keyword="@ViewData["Keyword"]">上一頁</a>
        </li>

        <!-- 開頭省略號 -->
        @if (startPage > 1)
        {
            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="1">1</a></li>
            @if (startPage > 2)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
        }

        <!-- 中間頁碼 -->
        @for (int i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == pageIndex ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-keyword="@ViewData["Keyword"]">@i</a>
            </li>
        }

        <!-- 結尾省略號 -->
        @if (endPage < totalPages)
        {
            @if (endPage < totalPages - 1)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@totalPages">@totalPages</a></li>
        }

        <!-- 下一頁 -->
        <li class="page-item @(pageIndex >= totalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(pageIndex + 1)" asp-route-keyword="@ViewData["Keyword"]">下一頁</a>
        </li>
    </ul>
</nav>
        </div>
    </div>
    </div>

<!-- 編輯 Modal -->
@foreach (var item in Model)
{
    <div class="modal fade" id="editModal-@item.CouponId" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Edit" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title">編輯優惠券</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="CouponId" value="@item.CouponId" />
                        <div class="mb-3">
                            <label class="form-label">名稱</label>
                            <input class="form-control" name="CouponName" value="@item.CouponName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">折扣碼</label>
                            <input class="form-control" name="DiscountCode" value="@item.DiscountCode" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">折扣方式</label>
                            <input class="form-control" name="DiscountMethod" value="@item.DiscountMethod" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">說明</label>
                            <input class="form-control" name="Description" value="@item.Description" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">折扣額度</label>
                            <input class="form-control" name="DiscountQuota" value="@item.DiscountQuota" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">最低消費</label>
                            <input class="form-control" name="LowSpend" value="@item.LowSpend" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">最短租期</label>
                            <input class="form-control" name="MinRentalPeriod" value="@item.MinRentalPeriod" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">最長租期</label>
                            <input class="form-control" name="MaxRentalPeriod" value="@item.MaxRentalPeriod" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">租期(起)</label>
                            <input type="date" class="form-control" name="StartRentalPeriod" value="@(item.StartRentalPeriod?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">租期(迄)</label>
                            <input type="date" class="form-control" name="EndRentalPeriod" value="@(item.EndRentalPeriod?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">到期日</label>
                            <input type="date" class="form-control" name="EndAt" value="@(item.EndAt?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                        <button type="submit" class="btn btn-primary">儲存</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- 新增 Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">新增優惠券</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">名稱</label>
                        <input class="form-control" name="CouponName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">折扣碼</label>
                        <input class="form-control" name="DiscountCode" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">折扣方式</label>
                        <input class="form-control" name="DiscountMethod" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">說明</label>
                        <input class="form-control" name="Description" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">折扣額度</label>
                        <input class="form-control" name="DiscountQuota" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">最低消費</label>
                        <input class="form-control" name="LowSpend" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">最短租期</label>
                        <input class="form-control" name="MinRentalPeriod" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">最長租期</label>
                        <input class="form-control" name="MaxRentalPeriod" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">租期(起)</label>
                        <input type="date" class="form-control" name="StartRentalPeriod" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">租期(迄)</label>
                        <input type="date" class="form-control" name="EndRentalPeriod" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">到期日</label>
                        <input type="date" class="form-control" name="EndAt" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-success">新增</button>
                </div>
            </form>
        </div>
    </div>
</div>
