@model RentalManagementPlatformMVC.Areas.Roles.ViewModels.RoleFormVm
@{
    ViewData["Title"] = "編輯角色";
    var roleId = ViewBag.RoleId;
}

<div class="content-header mt-3">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h2 class="m-0" style="font-family: 'Segoe UI', 'Microsoft JhengHei', Arial, sans-serif; font-weight: 700; letter-spacing: 1px; color: #2c3e50;">
                    編輯角色
                </h2>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline mb-3">
            <div class="card-body">
                <form method="post" asp-area="Roles" asp-controller="RolesManagement" asp-action="Edit">
                    @Html.AntiForgeryToken()
                    <input asp-for="RoleId" type="hidden" />
                    <div class="mb-3">
                        <label>角色名稱</label>
                        <input asp-for="RoleName" class="form-control" />
                        <span asp-validation-for="RoleName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label>角色代碼</label>
                        <input asp-for="RoleCode" class="form-control" />
                        <span asp-validation-for="RoleCode" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label>描述</label>
                        <textarea asp-for="Description" class="form-control"></textarea>
                    </div>
                    <div class="mt-3 text-end">
                        <a class="btn btn-outline-primary btn-sm"
                           asp-area="Roles"
                           asp-controller="RolesManagement"
                           asp-action="AssignUsers"
                           asp-route-roleId="@Model.RoleId">
                            指派使用者
                        </a>
                        <a class="btn btn-outline-info btn-sm"
                           asp-area="Roles"
                           asp-controller="RolesManagement"
                           asp-action="AssignPermissions"
                           asp-route-roleId="@Model.RoleId">
                            指派權限
                        </a>
                        <button type="submit" class="btn btn-primary me-2">更新</button>
                        <a asp-area="Roles" asp-controller="RolesManagement" asp-action="Index" class="btn btn-secondary">返回</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
